@if (TempData["success_notification"] is not null)
{
    <script>
        toastr.success('@TempData["success_notification"]')
    </script>
        toastr.success('@TempData["success_notification"]');
    </script>
    TempData.Remove("success_notification");
}
else if (TempData["error_notification"] is not null)
{
    <script>
        toastr.error('@TempData["error_notification"]')
    </script>
        toastr.error('@TempData["error_notification"]');
    </script>
    TempData.Remove("error_notification");
}
else if (TempData["warning_notification"] is not null)
{
    <script>
        toastr.warning('@TempData["warning_notification"]')
    </script>
        toastr.warning('@TempData["warning_notification"]');
    </script>
    TempData.Remove("warning_notification");
}
else if (TempData["info_notification"] is not null)
{
    <script>
        toastr.info('@TempData["info_notification"]')
    </script>
}
        toastr.info('@TempData["info_notification"]');
    </script>
    TempData.Remove("info_notification");
}
<script>
    window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
            (typeof window.performance != "undefined" && window.performance.navigation.type === 2);
        if (historyTraversal) {
            window.location.reload();
        }
    });
</script>
