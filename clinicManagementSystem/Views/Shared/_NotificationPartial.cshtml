@{
    var successJs = TempData["success_notification"] is not null
        ? System.Text.Json.JsonSerializer.Serialize(TempData["success_notification"]!.ToString()).Trim('"')
        : string.Empty;
    var errorJs = TempData["error_notification"] is not null
        ? System.Text.Json.JsonSerializer.Serialize(TempData["error_notification"]!.ToString()).Trim('"')
        : string.Empty;
    var warningJs = TempData["warning_notification"] is not null
        ? System.Text.Json.JsonSerializer.Serialize(TempData["warning_notification"]!.ToString()).Trim('"')
        : string.Empty;
    var infoJs = TempData["info_notification"] is not null
        ? System.Text.Json.JsonSerializer.Serialize(TempData["info_notification"]!.ToString()).Trim('"')
        : string.Empty;
}
@if (TempData["success_notification"] is not null)
{
    <script>
        toastr.success('@Html.Raw(successJs)');
    </script>
}
else if (TempData["error_notification"] is not null)
{
    <script>
        toastr.error('@Html.Raw(errorJs)');
    </script>
}
else if (TempData["warning_notification"] is not null)
{
    <script>
        toastr.warning('@Html.Raw(warningJs)');
    </script>
}
else if (TempData["info_notification"] is not null)
{
    <script>
        toastr.info('@Html.Raw(infoJs)');
    </script>
}

<script>
    window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted ||
            (typeof window.performance != "undefined" && window.performance.navigation.type === 2);
        if (historyTraversal) {
            window.location.reload();
        }
    });
</script>