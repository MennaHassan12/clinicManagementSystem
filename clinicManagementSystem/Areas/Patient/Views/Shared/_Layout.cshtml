@using Microsoft.AspNetCore.Identity
@using clinicManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthCare Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Top Bar -->
    <div class="bg-light border-bottom py-2 text-muted fs-7 d-none d-lg-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <span><i class="bi bi-geo-alt-fill text-primary me-1"></i> 123 Health Street, Cairo, Egypt</span>
                <span><i class="bi bi-envelope-fill text-primary me-1"></i> support@healthcareportal.com</span>
            </div>
            <div>
                <a class="text-decoration-none text-secondary fw-semibold" href="?culture=ar">
                    <i class="bi bi-globe me-1"></i> عربي
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-3 text-primary" href="/Patient/Home/Index">
                <i class="bi bi-heart-pulse-fill fs-2"></i>
                <span class="tracking-wide">HealthCare</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-semibold text-uppercase fs-7 gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link text-dark active" href="/Patient/Home/Index">Home</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark" href="#" id="pagesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Pages
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg rounded-3 py-2" aria-labelledby="pagesDropdown">
                            <li><a class="dropdown-item py-2" href="/Patient/Home/AllDoctors"><i class="bi bi-person-badge me-2 text-primary"></i>Doctors</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#departments"><i class="bi bi-hospital me-2 text-primary"></i>Departments</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#services"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Services</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#about"><i class="bi bi-info-circle me-2 text-primary"></i>About Us</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Blog/Index"><i class="bi bi-newspaper me-2 text-primary"></i>Blog</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#contact"><i class="bi bi-envelope me-2 text-primary"></i>Contact Us</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Home/Index#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Home/Index#services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Blog/Index">Blog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Home/Index#contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-primary rounded-pill px-4 dropdown-toggle fw-semibold" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" aria-labelledby="userMenu" style="min-width: 200px;">
                                <li>
                                    <a class="dropdown-item py-2 rounded-3 text-secondary" href="/Identity/Profile/Index">
                                        <i class="bi bi-gear me-2"></i>Profile Settings
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary rounded-pill px-4 fw-semibold" href="/Identity/Account/Login">Log In</a>
                        <a class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" href="/Identity/Account/Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="flex-shrink-0">
        <partial name="_NotificationPartial" />
        @RenderBody()
    </main>

    @if (SignInManager.IsSignedIn(User))
    {
        <button class="btn btn-primary py-3 px-2 shadow side-toggle-btn d-flex flex-column align-items-center gap-1" type="button" id="patientPortalToggle" title="Patient Portal">
            <i class="bi bi-person-badge fs-5"></i>
            <i class="bi bi-grid-fill small"></i>
        </button>

        <div class="card shadow-lg border-0 rounded-4 p-2" id="patientFloatingMenu">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pb-1 pt-2">
                <h6 class="card-title fw-bold mb-0 text-primary fs-7">
                    <i class="bi bi-grid-fill me-1"></i>Patient Portal
                </h6>
                <button type="button" class="btn-close small" id="closeFloatingMenu" aria-label="Close"></button>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2">
                <a href="/Patient/Appointments/MyAppointments" class="d-flex align-items-center gap-3 p-2 rounded-3 text-decoration-none text-dark floating-menu-item bg-light bg-opacity-50">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary">
                        <i class="bi bi-calendar-check-fill fs-6"></i>
                    </div>
                    <div>
                        <div class="fw-semibold fs-7 mb-0">Appointments</div>
                        <small class="text-muted fs-8">Manage bookings</small>
                    </div>
                </a>
                <a href="/Patient/MedicalFiles/Index" class="d-flex align-items-center gap-3 p-2 rounded-3 text-decoration-none text-dark floating-menu-item bg-light bg-opacity-50">
                    <div class="bg-info bg-opacity-10 p-2 rounded-3 text-info">
                        <i class="bi bi-file-earmark-medical-fill fs-6"></i>
                    </div>
                    <div>
                        <div class="fw-semibold fs-7 mb-0">Medical Files</div>
                        <small class="text-muted fs-8">Records & history</small>
                    </div>
                </a>
            </div>
        </div>
    }

    <!-- Footer -->
    <footer class="footer-with-bg text-white py-5 mt-auto">
        <div class="footer-overlay"></div>

        <div class="container text-center text-md-start position-relative" style="z-index: 2;">
            <div class="row g-4 mb-4">

                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-heart-pulse-fill me-2"></i>HealthCare</h5>
                    <p class="text-light opacity-75 fs-7">Providing trusted healthcare services, easy online appointment bookings, and comprehensive medical record management.</p>
                </div>

                <!-- Opening Hours -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-white mb-3"><i class="bi bi-clock me-2 text-primary"></i>Opening Hours</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-light opacity-75 fs-7">
                        <li class="d-flex justify-content-between"><span>Mon - Wed:</span> <span>8.00 - 18.00</span></li>
                        <li class="d-flex justify-content-between"><span>Thu - Fri:</span> <span>8.00 - 17.00</span></li>
                        <li class="d-flex justify-content-between"><span>Sat - Sun:</span> <span>9.00 - 15.00</span></li>
                        <li class="d-flex justify-content-between text-warning"><span>Holidays:</span> <span>Closed</span></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-white mb-3">Quick Links</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 fs-7">
                        <li><a href="/Patient/Home/Index#about" class="text-light opacity-75 text-decoration-none">About Us</a></li>
                        <li><a href="/Patient/Home/Index#services" class="text-light opacity-75 text-decoration-none">Services</a></li>
                        <li><a href="/Patient/Blog/Index" class="text-light opacity-75 text-decoration-none">Blog</a></li>
                        <li><a href="/Patient/Home/Index#contact" class="text-light opacity-75 text-decoration-none">Contact Us</a></li>
                        <li><a href="/Patient/Home/AllDoctors" class="text-light opacity-75 text-decoration-none">Our Doctors</a></li>
                    </ul>
                </div>


                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-white mb-3">Contact Info</h5>
                    <p class="text-light opacity-75 mb-2 fs-7"><i class="bi bi-geo-alt me-2 text-primary"></i>123 Health Street, Cairo, Egypt</p>
                    <p class="text-light opacity-75 mb-2 fs-7"><i class="bi bi-telephone me-2 text-primary"></i>+20 123 456 7890</p>
                    <p class="text-light opacity-75 fs-7"><i class="bi bi-envelope me-2 text-primary"></i>support@healthcareportal.com</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25">
            <div class="text-center pt-2">
                <small class="text-light opacity-50">&copy; @DateTime.Now.Year HealthCare Portal. All Rights Reserved.</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <partial name="_NotificationPartial" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>