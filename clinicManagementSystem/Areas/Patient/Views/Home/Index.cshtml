@model IEnumerable<clinicManagementSystem.Models.Doctor>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<clinicManagementSystem.SharedResource> SharedLocalizer
@{
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home - Healthcare Portal";
}


<!-- Hero Carousel Section -->
<div id="heroCarousel" class="carousel slide carousel-fade shadow-sm" data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
    </div>

    <div class="carousel-inner">
        <!-- Slide 1 -->
        <div class="carousel-item active" style="min-height: 85vh; background: linear-gradient(90deg, rgba(15, 23, 42, 0.60) 0%, rgba(15, 23, 42, 0.15) 100%), url('/images/home/hero2.jpg') 85% 25% / cover no-repeat;">
            <div class="container h-100 d-flex align-items-center" style="min-height: 85vh;">
                <div class="row w-100">
                    <div class="col-lg-8 text-white hero-animate">
                        <span class="badge bg-primary rounded-pill px-3 py-2 text-uppercase fw-semibold mb-3 tracking-wide">
                            @SharedLocalizer["World-Class Care"]
                        </span>
                        <h1 class="display-3 fw-bold mb-3">@SharedLocalizer["Your Health Is Our Top Priority"]</h1>
                        <p class="lead fs-4 text-light opacity-90 mb-4">
                            @SharedLocalizer["Discover expert physicians, schedule hassle-free appointments, and manage your medical records seamlessly in one place."]
                        </p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="/Patient/Home/AllDoctors" class="btn btn-primary rounded-pill px-4 py-3 fw-semibold shadow-lg">
                                @SharedLocalizer["Book Appointment Now"]
                            </a>
                            <a href="#contact" class="btn btn-outline-light rounded-pill px-4 py-3 fw-semibold">
                                @SharedLocalizer["Contact Us"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-item" style="min-height: 85vh; background: linear-gradient(90deg, rgba(15, 23, 42, 0.60) 0%, rgba(15, 23, 42, 0.15) 100%), url('/images/home/hero1.jpg') center 30% / cover no-repeat;">
            <div class="container h-100 d-flex align-items-center" style="min-height: 85vh;">
                <div class="row w-100">
                    <div class="col-lg-8 text-white hero-animate">
                        <span class="badge bg-info rounded-pill px-3 py-2 text-uppercase fw-semibold mb-3 tracking-wide">
                            @SharedLocalizer["Modern Facilities"]
                        </span>
                        <h1 class="display-3 fw-bold mb-3">@SharedLocalizer["Health Care For Whole Family"]</h1>
                        <p class="lead fs-4 text-light opacity-90 mb-4">
                            @SharedLocalizer["Providing exceptional healthcare service excellence through qualified physicians and state-of-the-art technology."]
                        </p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="/Patient/Home/AllDoctors" class="btn btn-primary rounded-pill px-4 py-3 fw-semibold shadow-lg">
                                @SharedLocalizer["Book Appointment Now"]
                            </a>
                            <a href="#contact" class="btn btn-outline-light rounded-pill px-4 py-3 fw-semibold">
                                @SharedLocalizer["Contact Us"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </div>
<!-- About Us Section -->
<section id="about" class="py-5 bg-light">
    <div class="container py-4">

        <!-- Section Header -->
        <div class="text-center mx-auto mb-5" style="max-width: 650px;">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold text-uppercase mb-2">
                @SharedLocalizer["About Us"]
            </span>
            <h2 class="fw-bold text-dark display-6">@SharedLocalizer["Knowing More About Our Healthcare"]</h2>
            <p class="text-muted mb-0">@SharedLocalizer["Dedicated to providing compassionate care and expert medical services to support your health journey."]</p>
        </div>

        <!-- Content Row -->
        <div class="row align-items-center g-4 g-lg-5">

            
            <div class="col-lg-6 position-relative">
                <div class="row g-3 align-items-center">

                    <!-- First Image -->
                    <div class="col-6">
                        <div class="rounded-5 overflow-hidden shadow-sm border" style="height: 400px;">
                            <img src="~/images/home/about-1.jpg" class="w-100 h-100 object-fit-cover" alt="Medical Facility">
                        </div>
                    </div>

                    <!-- Second Image -->
                    <div class="col-6">
                        <div class="rounded-5 overflow-hidden shadow-sm border" style="height: 400px;">
                            <img src="~/images/home/about-2.jpg" class="w-100 h-100 object-fit-cover" alt="Doctor Consultation">
                        </div>
                    </div>

                </div>

<div class="position-absolute bottom-0 start-0 m-3 bg-white p-3 px-3.5 rounded-4 shadow-sm border d-flex align-items-center gap-3" style="z-index: 10;">
    
    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-award-fill" viewBox="0 0 16 16">
            <path d="m8 0 1.669.864 1.858.282.842 1.68 1.337 1.32L13.4 6l.306 1.854-1.337 1.32-.842 1.68-1.858.282L8 12l-1.669-.864-1.858-.282-.842-1.68-1.337-1.32L2.6 6l-.306-1.854 1.337-1.32.842-1.68 1.337-.282z"/>
            <path d="M4 11.794V16l4-1 4 1v-4.206l-2.018.306L8 13.126l-1.982-.982z"/>
        </svg>
    </div>

    <div>
        <h3 class="fw-bold text-dark mb-0 lh-1 fs-4"><span id="yearsCounter" data-target="15">0</span>+</h3>
        <small class="text-muted fw-semibold text-uppercase fs-8" style="letter-spacing: 0.5px;">@SharedLocalizer["Years Experience"]</small>
    </div>

</div>
            </div>

            <div class="col-lg-6">

                <h3 class="fw-bold text-dark mb-3">
                    @SharedLocalizer["Best Care For Your"] <span class="text-primary">@SharedLocalizer["Good Health"]</span>
                </h3>

                <p class="text-muted mb-4 fs-6 lh-base">
                    @SharedLocalizer["Dedicated to providing compassionate care and expert medical services to support your health journey."]
                </p>

                <div class="d-flex flex-column gap-3 mb-4" style="max-width: 480px;">

                    <div class="p-3 bg-white rounded-4 border d-flex align-items-center gap-3 shadow-sm">
                        <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-person-check" viewBox="0 0 16 16">
                                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m1.679-4.493-1.335 2.226a.75.75 0 0 1-1.174.144l-.774-.773a.75.75 0 0 1 1.06-1.06l.367.367 1.002-1.67a.75.75 0 1 1 1.254.816" />
                                <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 4" />
                                <path d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10c.26 0 .507.009.74.025.226-.341.496-.65.804-.918C8.844 9.02 8.434 9 8 9c-5 0-6 3-6 4s1 1 1 1z" />
                            </svg>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0 fs-6">@SharedLocalizer["Certified Specialists"]</h6>
                            <small class="text-muted">@SharedLocalizer["Top Tier Doctors"]</small>
                        </div>
                    </div>

                    <div class="p-3 bg-white rounded-4 border d-flex align-items-center gap-3 shadow-sm">
                        <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-building-check" viewBox="0 0 16 16">
                                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m1.679-4.493-1.335 2.226a.75.75 0 0 1-1.174.144l-.774-.773a.75.75 0 0 1 1.06-1.06l.367.367 1.002-1.67a.75.75 0 1 1 1.254.816" />
                                <path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6.5a4.5 4.5 0 0 0-1 0V1H3v14h3v-2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2h1.071c.108.361.265.7.468 1H3a1 1 0 0 1-1-1z" />
                                <path d="M4.5 3h1v1h-1zM7 3h1v1H7zM4.5 6h1v1h-1zM7 6h1v1H7zM4.5 9h1v1h-1zM7 9h1v1H7zM4.5 12h1v1h-1zM7 12h1v1H7z" />
                            </svg>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0 fs-6">@SharedLocalizer["Modern Facilities"]</h6>
                            <small class="text-muted">@SharedLocalizer["Latest Equipment"]</small>
                        </div>
                    </div>

                </div>

                <a href="#services" class="btn btn-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    @SharedLocalizer["Discover More"]
                </a>

            </div>

        </div>
    </div>
</section>

@{

    var doctorRatings = ViewBag.DoctorRatings as Dictionary<int, double>
                        ?? new Dictionary<int, double>();
}

<!-- Top Rated Doctors Section -->
<section class="py-5 bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-primary fw-bold small text-uppercase tracking-wider">@SharedLocalizer["Certified Specialists"]</span>
                <h2 class="display-6 fw-bold text-dark mb-0">@SharedLocalizer["Meet Our Top Rated Specialists"]</h2>
            </div>
            <a href="/Patient/Home/AllDoctors" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                @SharedLocalizer["Show All Doctors"] <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>


        <div class="position-relative px-md-5">
            <div class="swiper topDoctorsSwiper py-3">
                <div class="swiper-wrapper">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var doctor in Model)
                        {

                            var rawName = doctor.ApplicationUser != null && !string.IsNullOrEmpty(doctor.ApplicationUser.FullName)
                                ? doctor.ApplicationUser.FullName.Trim()
                                : SharedLocalizer["Medical Specialist"].Value;

                            if (rawName.StartsWith("Dr. ", StringComparison.OrdinalIgnoreCase))
                            {
                                rawName = rawName.Substring(4).Trim();
                            }
                            else if (rawName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
                            {
                                rawName = rawName.Substring(3).Trim();
                            }
                            else if (rawName.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase))
                            {
                                rawName = rawName.Substring(3).Trim();
                            }

                            var displayName = $"Dr. {rawName}";


                            var rating = doctorRatings.TryGetValue(doctor.DoctorId, out var doctorRating)
                                ? doctorRating
                                : 0;


                            string imageSrc = "";
                            if (!string.IsNullOrEmpty(doctor.Image))
                            {
                                if (doctor.Image.StartsWith("http") || doctor.Image.StartsWith("/"))
                                {
                                    imageSrc = doctor.Image;
                                }
                                else
                                {
                                    imageSrc = $"/images/doctors/{doctor.Image}";
                                }
                            }

                            <div class="swiper-slide">

                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mx-auto my-2" style="max-width: 850px;">
                                    <div class="row g-0 align-items-center">


                                        <div class="col-md-4 bg-primary bg-opacity-10 text-center py-4 px-3 d-flex align-items-center justify-content-center" style="min-height: 220px;">
                                            @if (!string.IsNullOrEmpty(imageSrc))
                                            {
                                                <img src="@imageSrc"
                                                     class="rounded-circle border border-4 border-white shadow-sm"
                                                     style="width: 130px; height: 130px; object-fit: cover;"
                                                     alt="@displayName"
                                                     onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                                <div class="rounded-circle bg-white border align-items-center justify-content-center shadow-sm"
                                                     style="width: 130px; height: 130px; flex-shrink: 0; display: none;">
                                                    <i class="bi bi-person-fill text-secondary fs-1"></i>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-white d-flex align-items-center justify-content-center border shadow-sm"
                                                     style="width: 130px; height: 130px; flex-shrink: 0;">
                                                    <i class="bi bi-person-fill text-secondary fs-1"></i>
                                                </div>
                                            }
                                        </div>


                                        <div class="col-md-8">
                                            <div class="card-body p-4 text-start">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h3 class="fw-bold text-dark mb-1">@displayName</h3>
                                                        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-1 rounded-pill">
                                                            @(doctor.Department?.Name ?? SharedLocalizer["General"].Value)
                                                        </span>
                                                    </div>
                                                    <div class="bg-warning bg-opacity-10 text-warning px-3 py-1 rounded-pill fw-bold">
                                                        ★ @rating.ToString("0.0")
                                                    </div>
                                                </div>

                                                <div class="text-muted small mb-3">
                                                    <p class="mb-1"><i class="bi bi-award me-1 text-primary"></i> @doctor.YearsOfExperience @SharedLocalizer["Years Experience"]</p>
                                                    <p class="mb-0"><i class="bi bi-cash me-1 text-success"></i> @SharedLocalizer["Fee"]: @doctor.ConsultationFee @SharedLocalizer["EGP"]</p>
                                                </div>

                                                <div class="d-flex gap-2 pt-2">
                                                    <a href="/Patient/Appointments/DoctorDetails/@doctor.DoctorId" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-bold">
                                                        @SharedLocalizer["View Details"]
                                                    </a>
                                                    <a href="/Patient/Appointments/Book?doctorId=@doctor.DoctorId" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                                                        @SharedLocalizer["Book Now"]
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>


            <div class="swiper-button-next text-primary"></div>
            <div class="swiper-button-prev text-primary"></div>
            <div class="swiper-pagination mt-2 position-relative"></div>
        </div>
    </div>
</section>

    <section id="services" class="py-5 bg-light">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold text-uppercase">@SharedLocalizer["Portal Features"]</span>
                <h2 class="fw-bold text-dark mt-2 display-6">@SharedLocalizer["Our Core Services"]</h2>
                <p class="text-muted mx-auto" style="max-width: 600px;">@SharedLocalizer["Explore how our healthcare portal helps patients connect with qualified doctors and manage records effortlessly."]</p>
            </div>

            <div class="row g-4 align-items-center">

                <div class="col-lg-5">
                    <div class="nav flex-column nav-pills custom-services-tabs gap-2" id="v-pills-tab" role="tablist" aria-orientation="vertical">

                        <!-- 1. Easy Doctor Booking -->
                        <button class="nav-link active p-2 px-3 rounded-4 text-start d-flex align-items-center gap-3 border bg-white shadow-sm" id="v-pills-booking-tab" data-bs-toggle="pill" data-bs-target="#v-pills-booking" type="button" role="tab">
                            <div class="icon-box rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                                <i class="bi bi-calendar2-check fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark fs-6">@SharedLocalizer["Easy Doctor Booking"]</h6>
                                <small class="text-muted fs-7">@SharedLocalizer["Instant appointment scheduling"]</small>
                            </div>
                        </button>

                        <!-- 2. Multi-Specialty Care -->
                        <button class="nav-link p-2 px-3 rounded-4 text-start d-flex align-items-center gap-3 border bg-white shadow-sm" id="v-pills-specialties-tab" data-bs-toggle="pill" data-bs-target="#v-pills-specialties" type="button" role="tab">
                            <div class="icon-box rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                                <i class="bi bi-hospital fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark fs-6">@SharedLocalizer["Medical Departments"]</h6>
                                <small class="text-muted fs-7">@SharedLocalizer["Explore doctors by specialty"]</small>
                            </div>
                        </button>

                        <!-- 3. Digital Medical Records -->
                        <button class="nav-link p-2 px-3 rounded-4 text-start d-flex align-items-center gap-3 border bg-white shadow-sm" id="v-pills-records-tab" data-bs-toggle="pill" data-bs-target="#v-pills-records" type="button" role="tab">
                            <div class="icon-box rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                                <i class="bi bi-file-earmark-medical fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark fs-6">@SharedLocalizer["Digital Medical Records"]</h6>
                                <small class="text-muted fs-7">@SharedLocalizer["Access your history & diagnoses"]</small>
                            </div>
                        </button>

                        <!-- 4. Verified Doctor Profiles -->
                        <button class="nav-link p-2 px-3 rounded-4 text-start d-flex align-items-center gap-3 border bg-white shadow-sm" id="v-pills-doctors-tab" data-bs-toggle="pill" data-bs-target="#v-pills-doctors" type="button" role="tab">
                            <div class="icon-box rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                                <i class="bi bi-person-badge fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark fs-6">@SharedLocalizer["Verified Doctor Profiles"]</h6>
                                <small class="text-muted fs-7">@SharedLocalizer["Explore qualifications & experience"]</small>
                            </div>
                        </button>
                        <!-- 5. Appointment Tracking -->
                        <button class="nav-link p-2 px-3 rounded-4 text-start d-flex align-items-center gap-3 border bg-white shadow-sm" id="v-pills-tracking-tab" data-bs-toggle="pill" data-bs-target="#v-pills-tracking" type="button" role="tab">
                            <div class="icon-box rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                                <i class="bi bi-journal-check fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark fs-6">@SharedLocalizer["Appointment Status"]</h6>
                                <small class="text-muted fs-7">@SharedLocalizer["Track & manage active bookings"]</small>
                            </div>
                        </button>

                        <!-- 6. Direct Contact & Support -->
                        <button class="nav-link p-2 px-3 rounded-4 text-start d-flex align-items-center gap-3 border bg-white shadow-sm" id="v-pills-support-tab" data-bs-toggle="pill" data-bs-target="#v-pills-support" type="button" role="tab">
                            <div class="icon-box rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                                <i class="bi bi-headset fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark fs-6">@SharedLocalizer["Patient Assistance"]</h6>
                                <small class="text-muted fs-7">@SharedLocalizer["Send inquiries to administration"]</small>
                            </div>
                        </button>

                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="tab-content p-4 p-md-5 bg-white rounded-4 shadow-sm border" id="v-pills-tabContent" style="min-height: 400px;">

                        <!-- Tab 1: Easy Doctor Booking -->
                        <div class="tab-pane fade show active" id="v-pills-booking" role="tabpanel">
                            <div class="row align-items-center g-4">
                                <div class="col-md-7">
                                    <span class="badge bg-primary bg-opacity-10 text-primary mb-3">@SharedLocalizer["Feature 01"]</span>
                                    <h3 class="fw-bold text-dark mb-3">@SharedLocalizer["Book Appointments in Seconds"]</h3>
                                    <p class="text-muted mb-4 fs-7">@SharedLocalizer["Select your desired doctor, choose available date and time slots, and confirm your booking instantly through the portal."]</p>
                                    <ul class="list-unstyled d-flex flex-column gap-2 mb-4 fs-7">
                                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary"></i> @SharedLocalizer["Real-time slot reservation"]</li>
                                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary"></i> @SharedLocalizer["Choose preferred specialists easily"]</li>
                                    </ul>
                                    <a href="/Patient/Home/AllDoctors" class="btn btn-primary rounded-pill px-4">@SharedLocalizer["Find a Specialist"]</a>
                                </div>
                                <div class="col-md-5 d-none d-md-block text-center">
                                    <img src="~/images/services/booking.jpg" class="img-fluid rounded-4 object-fit-contain" style="max-height: 260px; width: 100%;" alt="Easy Doctor Booking">
                                </div>
                            </div>
                        </div>

                        <!-- Tab 2: Medical Departments -->
                        <div class="tab-pane fade" id="v-pills-specialties" role="tabpanel">
                            <div class="row align-items-center g-4">
                                <div class="col-md-7">
                                    <span class="badge bg-primary bg-opacity-10 text-primary mb-3">@SharedLocalizer["Feature 02"]</span>
                                    <h3 class="fw-bold text-dark mb-3">@SharedLocalizer["Explore Various Departments"]</h3>
                                    <p class="text-muted mb-4 fs-7">@SharedLocalizer["Browse through clinical specialties including Cardiology, Ophthalmology, Pediatrics, Neurology, and more."]</p>
                                    <ul class="list-unstyled d-flex flex-column gap-2 mb-4 fs-7">
                                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary"></i> @SharedLocalizer["Categorized doctor profiles"]</li>
                                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary"></i> @SharedLocalizer["Detailed department summaries"]</li>
                                    </ul>
                                    <a href="#departments" class="btn btn-primary rounded-pill px-4">@SharedLocalizer["View Departments"]</a>
                                </div>
                                <div class="col-md-5 d-none d-md-block text-center">
                                    <img src="~/images/services/departments.jpg" class="img-fluid rounded-4 object-fit-contain" style="max-height: 260px; width: 100%;" alt="Medical Departments">
                                </div>
                            </div>
                        </div>

                        <!-- Tab 3: Digital Medical Records -->
                        <div class="tab-pane fade" id="v-pills-records" role="tabpanel">
                            <div class="row align-items-center g-4">
                                <div class="col-md-7">
                                    <span class="badge bg-primary bg-opacity-10 text-primary mb-3">@SharedLocalizer["Feature 03"]</span>
                                    <h3 class="fw-bold text-dark mb-3">@SharedLocalizer["Secure Patient Records"]</h3>
                                    <p class="text-muted mb-4 fs-7">@SharedLocalizer["Access your clinical consultations, diagnoses history, and assigned medical records seamlessly from your dashboard."]</p>
