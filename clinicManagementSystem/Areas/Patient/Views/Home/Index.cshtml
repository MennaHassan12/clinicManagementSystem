                    {
                        string iconClass = "bi-hospital";
                        string deptName = dept.Name?.ToString().ToLower() ?? "";

                        if (deptName.Contains("eye") || deptName.Contains("ophthalm")) { iconClass = "bi-eye"; }
                        else if (deptName.Contains("heart") || deptName.Contains("cardio")) { iconClass = "bi-heart-pulse"; }
                        else if (deptName.Contains("dental") || deptName.Contains("teeth")) { iconClass = "bi-person-badge"; }
                        else if (deptName.Contains("bone") || deptName.Contains("ortho")) { iconClass = "bi-body-text"; }
                        else if (deptName.Contains("brain") || deptName.Contains("neuro")) { iconClass = "bi-activity"; }
                        else if (deptName.Contains("pediatric") || deptName.Contains("child")) { iconClass = "bi-emoji-smile"; }
