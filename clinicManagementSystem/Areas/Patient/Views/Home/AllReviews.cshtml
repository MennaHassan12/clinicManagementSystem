@model IEnumerable<clinicManagementSystem.Models.Review>

@{
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = SharedLocalizer["Patient Reviews"];
}

<section class="py-5 bg-light">
    <div class="container">

        <!-- Page Header -->
        <div class="text-center mb-4">
            <h2 class="fw-bold">@SharedLocalizer["What Our Patients Say"]</h2>
            <p class="text-muted">
                @SharedLocalizer["Read experiences and feedback from our patients"]
            </p>
        </div>

        <!-- Filter -->
        <form method="get"
              action="/Patient/Home/AllReviews"
              class="card border-0 shadow-sm rounded-4 p-3 mb-5 bg-white">

            <div class="row g-3 align-items-center">

                <div class="col-md-9">
                    <select name="departmentId"
                            id="departmentSelect"
                            class="form-select bg-light">

                        <option value="">
                            @SharedLocalizer["All Specialties"]
                        </option>

                        @if (ViewBag.Departments != null)
                        {
                            foreach (var dept in ViewBag.Departments)
                            {
                                var isSelected =
                                ViewBag.CurrentDepartment != null &&
                                (int)ViewBag.CurrentDepartment == dept.DepartmentId;

                                <option value="@dept.DepartmentId"
                                        selected="@isSelected">
                                    @dept.Name
                                </option>
                            }
                        }

                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary w-100 rounded-3 fw-bold">
                        <i class="bi bi-funnel me-1"></i>
                        @SharedLocalizer["Filter"]
                    </button>

                    <a href="/Patient/Home/AllReviews"
                       class="btn btn-outline-secondary rounded-3 fw-bold px-3"
                       title="@SharedLocalizer["Reset Filters"]">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>

                </div>

            </div>
        </form>


        <!-- Reviews -->
        <!-- Reviews -->
        <div class="row row-cols-1 row-cols-md-2 g-4">

            @if (Model != null && Model.Any())
            {
                foreach (var review in Model)
                {
                    var doctor = review.Appointment?.Doctor;

                    var rawName = doctor?.ApplicationUser?.FullName;

                    if (string.IsNullOrWhiteSpace(rawName))
                    {
                        rawName = "Medical Specialist";
                    }
                    else
                    {
                        rawName = rawName.Trim();

                        if (rawName.StartsWith("Dr. ", StringComparison.OrdinalIgnoreCase))
                            rawName = rawName.Substring(4).Trim();
                        else if (rawName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
                            rawName = rawName.Substring(3).Trim();
                        else if (rawName.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase))
                            rawName = rawName.Substring(3).Trim();
                    }

                    var displayName = $"Dr. {rawName}";

                    string imageSrc = "";

                    if (!string.IsNullOrEmpty(doctor?.Image))
                    {
                        if (doctor.Image.StartsWith("http") || doctor.Image.StartsWith("/"))
                            imageSrc = doctor.Image;
                        else
                            imageSrc = $"/images/doctors/{doctor.Image}";
                    }

                    <div class="col">

                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white">

                            <!-- Doctor information -->
                            <div class="d-flex align-items-center gap-3">

                                @if (!string.IsNullOrEmpty(imageSrc))
                                {
                                    <img src="@imageSrc"
                                         class="rounded-circle border shadow-sm"
                                         style="width:85px;height:85px;object-fit:cover;"
                                         alt="@displayName"
                                         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="rounded-circle bg-light border shadow-sm align-items-center justify-content-center"
                                         style="width:85px;height:85px;flex-shrink:0;display:none;">
                                        <i class="bi bi-person-fill text-secondary fs-1"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border shadow-sm"
                                         style="width:85px;height:85px;flex-shrink:0;">
                                        <i class="bi bi-person-fill text-secondary fs-1"></i>
                                    </div>
                                }

                                <div class="flex-grow-1">

                                    <span class="badge bg-light text-primary px-3 py-1 rounded-pill mb-1">
                                        @(doctor?.Department?.Name ?? SharedLocalizer["General"].Value)
                                    </span>

                                    <h5 class="fw-bold mb-2 text-dark">
                                        @displayName
                                    </h5>

                                    <small class="text-muted d-block">

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning"></i>
                                            }
                                        }

                                        <strong class="ms-1">
                                            @review.Rating / 5
                                        </strong>

                                    </small>

                                </div>

                            </div>

                            <!-- Review comment -->
                            <div class="mt-3 pt-2 border-top">

                                <p class="text-muted mb-2">
                                    <i class="bi bi-quote text-primary me-1"></i>

                                    @(string.IsNullOrWhiteSpace(review.Comment)
                                        ? "The patient left a rating without a written comment."
                                        : review.Comment)
                                </p>

                            </div>

                            <!-- Review date -->
                            <div class="d-flex mt-2 pt-2 border-top">

                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @review.ReviewDate.ToString("MMM dd, yyyy")
                                </small>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">

                    <i class="bi bi-chat-square-text fs-1 text-muted d-block mb-2"></i>

                    <h5 class="text-muted fw-bold">
                        @SharedLocalizer["No Reviews Found"]
                    </h5>

                    <p class="text-muted small">
                        @SharedLocalizer["There are no reviews for the selected specialty."]
                    </p>

                </div>
            }

        </div>

    </div>
</section>