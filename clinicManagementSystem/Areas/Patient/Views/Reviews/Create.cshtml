@model clinicManagementSystem.Models.Review

@{
    ViewData["Title"] = "Rate Your Doctor";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
    var appointments = ViewBag.Appointments as List<clinicManagementSystem.Models.Appointment> ?? new List<clinicManagementSystem.Models.Appointment>();
    int? selectedAppId = ViewBag.SelectedAppointmentId as int?;
}

<div class="container py-4" style="max-width: 700px;">

    <div class="mb-4">
        <h2 class="fw-bold text-primary mb-1">Rate Your Doctor</h2>
        <p class="text-muted">Share your visit experience to help us improve our healthcare services</p>
    </div>

    @if (TempData["error_notification"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["error_notification"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!appointments.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-info-circle text-primary display-4 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">No Completed Appointments Available for Review</h5>
                <p class="text-muted mb-4">
                    You can only submit reviews for appointments that are marked as completed by your doctor and have not been reviewed yet.
                </p>
                <a asp-area="Patient" asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-calendar-check me-1"></i> View My Appointments
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <form asp-area="Patient" asp-controller="Reviews" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="mb-4">
                        <label asp-for="AppointmentId" class="form-label fw-bold">Select Completed Visit / Doctor <span class="text-danger">*</span></label>
                        <select asp-for="AppointmentId" class="form-select form-select-lg rounded-3">
                            <option value="">-- Choose Your Visit --</option>
                            @foreach (var app in appointments)
                            {
                                bool isSelected = (Model.AppointmentId == app.AppointmentId) || (selectedAppId.HasValue && selectedAppId.Value == app.AppointmentId);
                                if (isSelected)
                                {
                                    <option value="@app.AppointmentId" selected>
                                        👨‍⚕️ @(app.Doctor?.ApplicationUser?.FullName ?? "Dr. #" + app.DoctorId)
                                        (@(app.Doctor?.Department?.Name ?? "General")) - @app.AppointmentDate.ToString("yyyy-MM-dd") @DateTime.Today.Add(app.AppointmentTime.ToTimeSpan()).ToString("hh:mm tt")
                                    </option>
                                }
                                else
                                {
                                    <option value="@app.AppointmentId">
                                        👨‍⚕️ @(app.Doctor?.ApplicationUser?.FullName ?? "Dr. #" + app.DoctorId)
                                        (@(app.Doctor?.Department?.Name ?? "General")) - @app.AppointmentDate.ToString("yyyy-MM-dd") @DateTime.Today.Add(app.AppointmentTime.ToTimeSpan()).ToString("hh:mm tt")
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="AppointmentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Rating" class="form-label fw-bold">Overall Rating <span class="text-danger">*</span></label>
                        <select asp-for="Rating" class="form-select form-select-lg rounded-3">
                            <option value="5">⭐⭐⭐⭐⭐ 5 - Excellent (Highly Satisfied)</option>
                            <option value="4">⭐⭐⭐⭐ 4 - Good (Satisfied)</option>
                            <option value="3">⭐⭐⭐ 3 - Average (Neutral)</option>
                            <option value="2">⭐⭐ 2 - Poor (Unsatisfied)</option>
                            <option value="1">⭐ 1 - Very Poor (Very Unsatisfied)</option>
                        </select>
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Comment" class="form-label fw-bold">Feedback / Comments (Optional)</label>
                        <textarea asp-for="Comment" class="form-control rounded-3" rows="4" maxlength="1000" placeholder="Tell us more about your consultation, doctor's attentiveness, and clinic service..."></textarea>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-send-fill me-1"></i> Submit Review
                        </button>
                        <a asp-area="Patient" asp-controller="Reviews" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>
