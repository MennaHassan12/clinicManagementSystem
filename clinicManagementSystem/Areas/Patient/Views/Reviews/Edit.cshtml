@model clinicManagementSystem.Models.Review

@{
    ViewData["Title"] = "Edit Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Edit Review
        </h2>

        <p class="text-muted">
            Update your review
        </p>

    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="post"
                  action="/Patient/Reviews/Edit/@Model.ReviewId">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ReviewId"
                       value="@Model.ReviewId" />

                <input type="hidden"
                       name="AppointmentId"
                       value="@Model.AppointmentId" />


                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Appointment
                    </label>

                    <input type="text"
                           class="form-control"
                           value="Appointment #@Model.AppointmentId"
                           readonly />

                </div>


                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Rating
                    </label>

                    <select name="Rating"
                            class="form-select">

                        <option value="1" selected="@(Model.Rating == 1)">
                            1 - Very Poor
                        </option>

                        <option value="2" selected="@(Model.Rating == 2)">
                            2 - Poor
                        </option>

                        <option value="3" selected="@(Model.Rating == 3)">
                            3 - Average
                        </option>

                        <option value="4" selected="@(Model.Rating == 4)">
                            4 - Good
                        </option>

                        <option value="5" selected="@(Model.Rating == 5)">
                            5 - Excellent
                        </option>

                    </select>

                </div>


                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Comment
                    </label>

                    <textarea name="Comment"
                              class="form-control"
                              rows="5"
                              maxlength="1000">@Model.Comment</textarea>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary rounded-3">

                        <i class="bi bi-check-lg"></i>
                        Save Changes

                    </button>


                    <a href="/Patient/Reviews"
                       class="btn btn-secondary rounded-3">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>