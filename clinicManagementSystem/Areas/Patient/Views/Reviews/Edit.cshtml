@model clinicManagementSystem.Models.Review

@{
    ViewData["Title"] = SharedLocalizer["Edit"];
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 700px;">

    <div class="mb-4">
        <h2 class="fw-bold text-primary mb-1">@SharedLocalizer["Edit"]</h2>
        <p class="text-muted">@SharedLocalizer["Track and manage your medical appointments"]</p>
    </div>

    @if (TempData["error_notification"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["error_notification"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <form asp-area="Patient" asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.ReviewId" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ReviewId" />
                <input type="hidden" asp-for="AppointmentId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="mb-4">
                    <label class="form-label fw-bold">@SharedLocalizer["Doctor"]</label>
                    <div class="form-control bg-light rounded-3 py-2">
                        👨‍⚕️ @(Model.Appointment?.Doctor?.ApplicationUser?.FullName ?? "Doctor #" + Model.Appointment?.DoctorId)
                        - @SharedLocalizer["DATE & TIME"]: @(Model.Appointment != null ? Model.Appointment.AppointmentDate.ToString("yyyy-MM-dd") : "N/A")
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Rating" class="form-label fw-bold">@SharedLocalizer["Rating"] <span class="text-danger">*</span></label>
                    <select asp-for="Rating" class="form-select form-select-lg rounded-3">
                        <option value="5">⭐⭐⭐⭐⭐ 5</option>
                        <option value="4">⭐⭐⭐⭐ 4</option>
                        <option value="3">⭐⭐⭐ 3</option>
                        <option value="2">⭐⭐ 2</option>
                        <option value="1">⭐ 1</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Comment" class="form-label fw-bold">@SharedLocalizer["Comment"]</label>
                    <textarea asp-for="Comment" class="form-control rounded-3" rows="4" maxlength="1000"></textarea>
                    <span asp-validation-for="Comment" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                         @SharedLocalizer["Send Message"]
                    </button>
                    <a asp-area="Patient" asp-controller="Reviews" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        @SharedLocalizer["Cancel"]
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
