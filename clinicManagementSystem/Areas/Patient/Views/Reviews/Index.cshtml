@model IEnumerable<clinicManagementSystem.Models.Review>

@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">My Reviews</h2>

            <p class="text-muted mb-0">
                Manage your reviews
            </p>
        </div>

        <a href="/Patient/Reviews/Create"
           class="btn btn-primary rounded-3">

            <i class="bi bi-plus-lg"></i>
            Add Review

        </a>

    </div>


    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <h5>No Reviews Yet</h5>

                <p class="text-muted mb-3">
                    You haven't submitted any reviews.
                </p>

                <a href="/Patient/Reviews/Create"
                   class="btn btn-primary rounded-3">

                    <i class="bi bi-plus-lg"></i>
                    Add Review

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Appointment</th>
                                <th>Rating</th>
                                <th>Comment</th>
                                <th>Review Date</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var review in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            #@review.AppointmentId
                                        </span>
                                    </td>

                                    <td>

                                        <span class="fw-semibold me-2">
                                            @review.Rating / 5
                                        </span>

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(review.Comment)
                                            ? "No comment"
                                            : review.Comment)
                                    </td>

                                    <td>
                                        @review.ReviewDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <a href="/Patient/Reviews/Edit/@review.ReviewId"
                                               class="btn btn-warning btn-sm rounded-3">

                                                <i class="bi bi-pencil"></i>
                                                Edit

                                            </a>

                                            <a href="/Patient/Reviews/Delete/@review.ReviewId"
                                               class="btn btn-danger btn-sm rounded-3">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>