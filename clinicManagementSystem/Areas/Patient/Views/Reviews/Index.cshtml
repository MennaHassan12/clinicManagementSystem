@model IEnumerable<clinicManagementSystem.Models.Review>

@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    @if (TempData["success_notification"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["success_notification"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["error_notification"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["error_notification"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">My Doctor Reviews</h2>
            <p class="text-muted mb-0">Manage feedback and ratings you submitted for your visits</p>
        </div>

        <a asp-area="Patient" asp-controller="Reviews" asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-star-fill me-1"></i> Add Review
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-chat-heart text-muted display-4 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">No Reviews Yet</h5>
                <p class="text-muted mb-4">
                    You haven't submitted any reviews for your completed appointments yet.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-area="Patient" asp-controller="Reviews" asp-action="Create" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-plus-lg me-1"></i> Write a Review
                    </a>
                    <a asp-area="Patient" asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-calendar-check me-1"></i> My Appointments
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 px-4">DOCTOR</th>
                            <th class="py-3 px-4">APPOINTMENT DATE</th>
                            <th class="py-3 px-4">RATING</th>
                            <th class="py-3 px-4">COMMENT</th>
                            <th class="py-3 px-4">REVIEW DATE</th>
                            <th class="py-3 px-4 text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="fw-bold text-dark">
                                        @(review.Appointment?.Doctor?.ApplicationUser?.FullName ?? "Doctor #" + (review.Appointment?.DoctorId))
                                    </div>
                                    <small class="text-muted">
                                        @(review.Appointment?.Doctor?.Department?.Name ?? "General Department")
                                    </small>
                                </td>
                                <td class="px-4">
                                    <span class="badge bg-light text-dark border">
                                        @(review.Appointment != null ? review.Appointment.AppointmentDate.ToString("yyyy-MM-dd") : "N/A")
                                    </span>
                                </td>
                                <td class="px-4">
                                    <div class="text-warning text-nowrap">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted opacity-50"></i>
                                            }
                                        }
                                        <span class="ms-1 fw-bold text-dark small">(@review.Rating/5)</span>
                                    </div>
                                </td>
                                <td class="px-4 text-break" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(review.Comment) ? Html.Raw("<span class='text-muted fst-italic'>No written comment</span>") : review.Comment)
                                </td>
                                <td class="px-4 text-muted small">
                                    @review.ReviewDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="px-4 text-end text-nowrap">
                                    <a asp-area="Patient" asp-controller="Reviews" asp-action="Edit" asp-route-id="@review.ReviewId" class="btn btn-outline-warning btn-sm rounded-pill px-3 me-1">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <a asp-area="Patient" asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.ReviewId" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>