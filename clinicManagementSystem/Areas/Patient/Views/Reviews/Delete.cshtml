@model clinicManagementSystem.Models.Review

@{
    ViewData["Title"] = "Delete Review";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Delete Review
        </h2>

        <p class="text-muted">
            Are you sure you want to delete this review?
        </p>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Appointment
                </dt>

                <dd class="col-sm-9">
                    #@Model.AppointmentId
                </dd>


                <dt class="col-sm-3">
                    Rating
                </dt>

                <dd class="col-sm-9">

                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.Rating)
                        {
                            <i class="bi bi-star-fill text-warning"></i>
                        }
                        else
                        {
                            <i class="bi bi-star text-muted"></i>
                        }
                    }

                    <span class="ms-2">
                        @Model.Rating / 5
                    </span>

                </dd>


                <dt class="col-sm-3">
                    Comment
                </dt>

                <dd class="col-sm-9">

                    @(string.IsNullOrWhiteSpace(Model.Comment)
                        ? "No comment"
                        : Model.Comment)

                </dd>


                <dt class="col-sm-3">
                    Review Date
                </dt>

                <dd class="col-sm-9">
                    @Model.ReviewDate.ToString("dd/MM/yyyy")
                </dd>

            </dl>


            <form method="post"
                  action="/Patient/Reviews/DeleteConfirmed/@Model.ReviewId">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger rounded-3">

                    <i class="bi bi-trash"></i>
                    Yes, Delete

                </button>


                <a href="/Patient/Reviews"
                   class="btn btn-secondary rounded-3">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>