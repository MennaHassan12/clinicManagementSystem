@model clinicManagementSystem.Models.Review

@{
    ViewData["Title"] = "Delete Review";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 650px;">

    <div class="mb-4">
        <h2 class="fw-bold text-danger mb-1">Delete Review</h2>
        <p class="text-muted">Are you sure you want to delete this doctor review?</p>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Doctor</dt>
                <dd class="col-sm-8 fw-bold text-dark">
                    👨‍⚕️ @(Model.Appointment?.Doctor?.ApplicationUser?.FullName ?? "Doctor #" + Model.Appointment?.DoctorId)
                </dd>

                <dt class="col-sm-4 text-muted">Visit Date</dt>
                <dd class="col-sm-8">
                    @(Model.Appointment != null ? Model.Appointment.AppointmentDate.ToString("yyyy-MM-dd") : "N/A")
                </dd>

                <dt class="col-sm-4 text-muted">Rating</dt>
                <dd class="col-sm-8">
                    <div class="text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.Rating)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted opacity-50"></i>
                            }
                        }
                        <span class="ms-1 fw-bold text-dark">(@Model.Rating/5)</span>
                    </div>
                </dd>

                <dt class="col-sm-4 text-muted">Comment</dt>
                <dd class="col-sm-8 text-break">
                    @(string.IsNullOrWhiteSpace(Model.Comment) ? Html.Raw("<span class='text-muted fst-italic'>No comment</span>") : Model.Comment)
                </dd>

                <dt class="col-sm-4 text-muted">Review Date</dt>
                <dd class="col-sm-8 text-muted">
                    @Model.ReviewDate.ToString("yyyy-MM-dd")
                </dd>
            </dl>

            <form asp-area="Patient" asp-controller="Reviews" asp-action="Delete" asp-route-id="@Model.ReviewId" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash me-1"></i> Yes, Delete
                    </button>
                    <a asp-area="Patient" asp-controller="Reviews" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>