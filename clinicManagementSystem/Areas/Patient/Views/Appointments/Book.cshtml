@model clinicManagementSystem.ViewModels.PatientBookingVM

@{
    ViewData["Title"] = "Book Appointment";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";
    var timeSlots = ViewBag.TimeSlots as List<SelectListItem> ?? new List<SelectListItem>();
    int selectedDayOfWeek = ViewBag.SelectedDayOfWeek ?? 1;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="d-flex align-items-center mb-4 gap-2">
                    <a asp-area="Patient" asp-controller="Home" asp-action="AllDoctors" class="btn btn-sm btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Back">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h3 class="fw-bold text-primary mb-0">Book an Appointment</h3>
                </div>

                @if (TempData["error_notification"] != null)
                {
                    <div class="alert alert-danger mb-3 rounded-3">@TempData["error_notification"]</div>
                }

                <form id="patientBookingForm" asp-area="Patient" asp-controller="Appointments" asp-action="Book" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="DoctorId" id="DoctorId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Doctor</label>
                        <input type="text" class="form-control bg-light fw-bold text-primary" value="@Model?.DoctorName" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Working Shift / Day</label>
                        @if (Model?.AvailableSchedules != null && Model.AvailableSchedules.Any())
                        {
                            <select asp-for="DoctorScheduleId" id="DoctorScheduleId" class="form-select">
                                @foreach (var schedule in Model.AvailableSchedules)
                                {
                                    bool isSelected = Model.DoctorScheduleId == schedule.DoctorScheduleId;
                                    <option value="@schedule.DoctorScheduleId" selected="@(isSelected ? "selected" : null)">
                                        @schedule.DayOfWeek (@DateTime.Today.Add(schedule.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(schedule.EndTime).ToString("hh:mm tt"))
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="DoctorScheduleId" class="text-danger small d-block mt-1"></span>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 mb-0">No working shifts available for this doctor.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Patient Name *</label>
                        <input asp-for="PatientName" id="PatientName" class="form-control" placeholder="Enter patient full name" />
                        <span asp-validation-for="PatientName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address *</label>
                        <input asp-for="PatientEmail" id="PatientEmail" class="form-control" placeholder="example@domain.com" />
                        <span asp-validation-for="PatientEmail" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number *</label>
                        <input asp-for="PatientPhone" id="PatientPhone" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PatientPhone" class="text-danger small d-block mt-1"></span>
                    </div>


                    <div class="mb-3">
                        <label class="form-label fw-bold">Date of Birth *</label>
                        <input asp-for="BirthDate" type="date" id="BirthDate" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Date *</label>
                        <input asp-for="AppointmentDate" type="date" id="appointmentDate" class="form-control" 
                               data-target-day="@selectedDayOfWeek" 
                               data-default-date="@Model?.AppointmentDate" />
                        <span asp-validation-for="AppointmentDate" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Time Slot *</label>
                        @if (timeSlots.Any())
                        {
                            <select name="appointmentTime" id="appointmentTime" class="form-select" required>
                                <option value="">-- Choose Time Slot --</option>
                                @foreach (var slot in timeSlots)
                                {
                                    <option value="@slot.Value">@slot.Text</option>
                                }
                            </select>
                            <span asp-validation-for="AppointmentTime" class="text-danger small d-block mt-1"></span>
                        }
                        else
                        {
                            <div class="alert alert-danger py-2 text-center mb-0">
                                No slots available for this schedule.
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Notes / Symptoms (Optional)</label>
                        <textarea asp-for="Notes" id="Notes" class="form-control" rows="3" placeholder="Describe your symptoms..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm rounded-pill" @(timeSlots.Any() ? "" : "disabled")>
                            <i class="bi bi-calendar-check me-1"></i> Confirm & Book
                        </button>
                        <a asp-area="Patient" asp-controller="Home" asp-action="AllDoctors" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-pill">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/patientBookAppointment.js" asp-append-version="true"></script>
}