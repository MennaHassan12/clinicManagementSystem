@model IEnumerable<clinicManagementSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int currentPatientId = ViewBag.PatientId ?? 1;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Doctors Directory</h2>
            <p class="text-muted mb-0">Choose a specialist to book an appointment</p>
        </div>
        <a href="/Patient/Appointments/MyAppointments?patientId=@currentPatientId" class="btn btn-outline-primary rounded-3 fw-semibold px-4 py-2 shadow-sm">
            📋 My Appointments
        </a>
    </div>


    <div class="row mb-4">
        <div class="col-md-4">
            <form method="get" action="/Patient/Appointments/Doctors">
                <input type="hidden" name="patientId" value="@currentPatientId" />
                <label class="form-label fw-bold small text-muted">Filter by Department:</label>
                <select name="departmentId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in (SelectList)ViewBag.Departments)
                        {
                            <option value="@dept.Value" selected="@(dept.Selected ? "selected" : null)">@dept.Text</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var doctor in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 text-center p-3">
                        <div class="d-flex justify-content-center my-3">
                            @if (!string.IsNullOrEmpty(doctor.Image))
                            {
                                <img src="~/images/doctors/@doctor.Image" class="rounded-circle object-fit-cover shadow-sm" style="width: 100px; height: 100px;" alt="Doctor Image" />
                            }
                            else
                            {
                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold fs-1 shadow-sm" style="width: 100px; height: 100px;">
                                    👨‍⚕️
                                </div>
                            }
                        </div>

                        <div class="card-body p-0 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">@(doctor.ApplicationUser?.FullName ?? $"Dr. #{doctor.DoctorId}")</h5>
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill mb-3 px-3 py-2">
                                    @(doctor.Department?.Name ?? "General")
                                </span>

                                @if (!string.IsNullOrEmpty(doctor.Bio))
                                {
                                    <p class="text-muted small mb-3">@doctor.Bio</p>
                                }
                            </div>

                            <div class="pt-3 border-top d-flex flex-column gap-2 mt-auto">
                                <a href="/Patient/Appointments/DoctorDetails/@doctor.DoctorId?patientId=@currentPatientId" class="btn btn-light w-100 fw-semibold border">
                                    Details
                                </a>
                                <a href="/Patient/Appointments/Book?doctorId=@doctor.DoctorId&patientId=@currentPatientId" class="btn btn-primary w-100 fw-semibold shadow-sm">
                                    Book Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <h5>No doctors found.</h5>
            </div>
        }
    </div>
</div>