@model IEnumerable<clinicManagementSystem.Models.BlogPost>

@{
    ViewData["Title"] = "Health Articles & News";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-5">

    <div class="text-center mb-5">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold text-uppercase mb-2">
            Medical Insights
        </span>
        <h1 class="fw-bold display-5">Our Health Blog & Articles</h1>
        <p class="text-muted">Stay informed with the latest health tips and medical news from our experts.</p>
    </div>


    <form method="get" action="@Url.Action("Index", "Blog", new { area = "Patient" })" class="row g-2 mb-5 justify-content-center">
        <div class="col-md-4">
            <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control rounded-pill px-4" placeholder="Search articles by keyword..." />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select rounded-pill px-3">
                <option value="">All Categories</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (List<string>)ViewBag.Categories)
                    {
                        <option value="@cat" selected="@(ViewBag.CurrentCategory == cat ? "selected" : null)">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 col-6">
            <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold">
                <i class="bi bi-search me-1"></i> Filter
            </button>
        </div>

        <div class="col-md-2 col-6">
            <a href="@Url.Action("Index", "Blog", new { area = "Patient" })" class="btn btn-outline-secondary rounded-pill w-100 fw-semibold">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </a>
        </div>
    </form>


    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var blog in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden">
                        <div style="height: 220px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(blog.Image))
                            {
                                <img src="@blog.Image" class="card-img-top w-100 h-100" alt="@blog.Title" style="object-fit: cover; object-position: center;" />
                            }
                            else
                            {
                                <img src="/images/default-blog.jpg" class="card-img-top w-100 h-100" alt="Default Image" style="object-fit: cover; object-position: center;" />
                            }
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @blog.BadgeClass px-3 py-1 rounded-pill">
                                        @blog.Category
                                    </span>
                                    <small class="text-muted fs-8">
                                        <i class="bi bi-clock me-1"></i> @blog.ReadTime
                                    </small>
                                </div>
                                <h5 class="card-title fw-bold text-dark mt-2">@blog.Title</h5>
                                <small class="text-muted d-block mb-3">
                                    By <strong>@blog.Author</strong> • @blog.CreatedDate.ToString("MMM dd, yyyy")
                                </small>
                            </div>

                            <a href="@Url.Action("Details", "Blog", new { area = "Patient", id = blog.Id })" class="btn btn-outline-primary rounded-pill w-100 fw-semibold">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-journal-x text-muted display-4 d-block mb-3"></i>
                <h4 class="text-muted fw-bold">No Articles Found</h4>
                <p class="text-muted">Try adjusting your search criteria or category filter.</p>
                <a href="@Url.Action("Index", "Blog", new { area = "Patient" })" class="btn btn-outline-primary rounded-pill px-4 mt-2">
                    Reset Filters
                </a>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-5">
            <ul class="pagination pagination-md gap-1">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-circle" href="@Url.Action("Index", "Blog", new { area = "Patient", page = currentPage - 1, searchTerm = ViewBag.CurrentSearch, category = ViewBag.CurrentCategory })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link rounded-circle" href="@Url.Action("Index", "Blog", new { area = "Patient", page = i, searchTerm = ViewBag.CurrentSearch, category = ViewBag.CurrentCategory })">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link rounded-circle" href="@Url.Action("Index", "Blog", new { area = "Patient", page = currentPage + 1, searchTerm = ViewBag.CurrentSearch, category = ViewBag.CurrentCategory })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>