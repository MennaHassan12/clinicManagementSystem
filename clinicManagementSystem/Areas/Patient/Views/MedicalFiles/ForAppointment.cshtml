@model IEnumerable<clinicManagementSystem.Models.MedicalFile>

@{
    ViewData["Title"] = "Medical Files";
    Layout = "~/Areas/Patient/Views/Shared/_Layout.cshtml";

    var firstFile = Model.FirstOrDefault();
    var appointment = firstFile?.MedicalRecord?.Appointment;
    var doctor = appointment?.Doctor;
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-primary mb-1">
                Medical Files
            </h2>

            <p class="text-muted mb-0">
                Medical files for your appointment
            </p>

        </div>

        <a asp-area="Patient"
           asp-controller="MedicalFiles"
           asp-action="Index"
           class="btn btn-primary shadow-sm rounded-pill px-4">

            <i class="fas fa-arrow-left me-1"></i>
            Back to Medical Files

        </a>

    </div>


    <!-- DOCTOR INFORMATION -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center">

                <div class="bg-primary-subtle rounded-circle p-3 me-3">
                    <i class="fas fa-user-md text-primary fa-2x"></i>
                </div>

                <div>

                    <h4 class="fw-bold mb-1">
                        @(doctor?.ApplicationUser?.FullName ?? "Doctor")
                    </h4>

                    <div class="text-muted">
                        @(doctor?.Department?.Name ?? "Department")
                    </div>

                    <div class="text-muted small mt-1">
                        <i class="fas fa-calendar-alt me-1"></i>
                        Appointment:
                        @appointment!.AppointmentDate.ToString("dd/MM/yyyy")
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FILES -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                <i class="fas fa-folder-open text-primary me-2"></i>
                Medical Files
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>File</th>
                            <th>Medical Record</th>
                            <th>File Type</th>
                            <th>Upload Date</th>
                            <th class="text-center">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var file in Model)
                        {
                            <tr>

                                <!-- FILE -->
                                <td>

                                    <i class="fas fa-file-medical text-primary me-2"></i>

                                    <span class="fw-semibold">
                                        @file.FileName
                                    </span>

                                </td>


                                <!-- MEDICAL RECORD -->
                                <td>

                                    <span class="badge bg-info">
                                        Record #@file.MedicalRecordId
                                    </span>

                                </td>


                                <!-- FILE TYPE -->
                                <td>

                                    @if (file.FileType == ".pdf")
                                    {
                                        <span class="badge bg-danger">
                                            PDF
                                        </span>
                                    }
                                    else if (
                                    file.FileType == ".jpg" ||
                                    file.FileType == ".jpeg" ||
                                    file.FileType == ".png")
                                    {
                                        <span class="badge bg-success">
                                            Image
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @file.FileType
                                        </span>
                                    }

                                </td>


                                <!-- DATE -->
                                <td>
                                    @file.UploadDate.ToString("dd/MM/yyyy")
                                </td>


                                <!-- ACTIONS -->
                                <td class="text-center">

                                    <a asp-area="Patient"
                                       asp-controller="MedicalFiles"
                                       asp-action="ViewFile"
                                       asp-route-id="@file.MedicalFileId"
                                       target="_blank"
                                       class="btn  btn-outline-primary rounded-pill px-3 me-1">

                                        <i class="fas fa-eye me-1"></i>
                                        View

                                    </a>

                                    <a asp-area="Patient"
                                       asp-controller="MedicalFiles"
                                       asp-action="Download"
                                       asp-route-id="@file.MedicalFileId"
                                       class="btn  btn-outline-success rounded-pill px-3">

                                        <i class="fas fa-download me-1"></i>
                                        Download

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
