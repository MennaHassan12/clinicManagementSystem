@model clinicManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger mb-1">
                Delete Department
            </h2>

            <p class="text-muted mb-0">
                Review the department information before deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3">

            <i class="fas fa-arrow-left me-1"></i>
            Back to Departments

        </a>

    </div>


    <!-- Delete Card -->
    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-body p-4">

            <div class="alert alert-warning d-flex align-items-center mb-4"
                 role="alert">

                <i class="fas fa-exclamation-triangle me-2"></i>

                <div>
                    <strong>Are you sure?</strong>
                    This department will be permanently deleted.
                </div>

            </div>


            <!-- Department Information -->

            <div class="mb-4">

                <h5 class="fw-bold text-primary mb-3">
                    Department Information
                </h5>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Department Name
                        </label>

                        <div class="form-control bg-light">
                            @Html.DisplayFor(model => model.Name)
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Department ID
                        </label>

                        <div class="form-control bg-light">
                            @Html.DisplayFor(model => model.DepartmentId)
                        </div>

                    </div>


                    <div class="col-12 mb-3">

                        <label class="form-label fw-semibold">
                            Description
                        </label>

                        <div class="form-control bg-light"
                             style="min-height: 100px;">

                            @Html.DisplayFor(model => model.Description)

                        </div>

                    </div>

                </div>

            </div>


            <!-- Buttons -->

            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="DepartmentId" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary px-4">

                        <i class="fas fa-times me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="fas fa-trash me-1"></i>
                        Delete Department

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>