@model clinicManagementSystem.Models.Department

@{
    ViewData["Title"] = SharedLocalizer["Create Department"];
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <h1 class="mb-3">@SharedLocalizer["Create Department"]</h1>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@SharedLocalizer["Add New Department"]</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="form-group mb-3">
    <label asp-for="Name" class="form-label">@SharedLocalizer["Department Name"]</label>

    <input asp-for="Name"
           class="form-control"
           placeholder="@SharedLocalizer["Enter department name"]" />

    <span asp-validation-for="Name"
          class="text-danger">
    </span>
</div>

<div class="form-group mb-3">
    <label asp-for="Description" class="form-label">@SharedLocalizer["Department Description"]</label>

    <textarea asp-for="Description"
              class="form-control"
              rows="4"
              placeholder="@SharedLocalizer["Enter department description"]"></textarea>

    <span asp-validation-for="Description"
          class="text-danger">
    </span>
</div>

                <button type="submit" class="btn btn-primary rounded-pill">
                     @SharedLocalizer["Save"]
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary rounded-pill">
                    @SharedLocalizer["Cancel"]
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}