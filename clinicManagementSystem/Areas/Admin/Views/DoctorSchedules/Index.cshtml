@model IEnumerable<IGrouping<clinicManagementSystem.Models.Doctor, clinicManagementSystem.Models.DoctorSchedule>>

@{
    ViewData["Title"] = "Doctor Schedules";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Doctor Schedules</h2>
            <p class="text-muted mb-0">Manage clinic working hours and max patient capacity per doctor</p>
        </div>
        <a asp-area="Admin" asp-controller="DoctorSchedules" asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
            + Add Schedule
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
                <select name="doctorId" class="form-select" asp-items="ViewBag.Doctors">
                    <option value="">-- All Doctors --</option>
                </select>
                <button type="submit" class="btn btn-secondary px-4">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var doctorGroup in Model)
        {
            var doctor = doctorGroup.Key;
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-light d-flex align-items-center justify-content-between py-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(doctor.Image))
                        {
                            <img src="~/images/doctors/@doctor.Image" 
                                 class="rounded-circle object-fit-cover shadow-sm border" 
                                 style="width: 45px; height: 45px;" 
                                 alt="Doctor Photo" />
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 45px; height: 45px;">
                                @(doctor.ApplicationUser?.FullName?.FirstOrDefault() ?? 'D')
                            </div>
                        }
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                Dr. @(doctor.ApplicationUser?.FullName ?? $"Doctor #{doctor.DoctorId}")
                            </h5>
                            <small class="text-muted">Total Working Days: @doctorGroup.Count()</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-white border-bottom">
                                <tr class="text-secondary small text-uppercase fw-bold">
                                    <th class="ps-4 py-3">Day</th>
                                    <th>Working Hours</th>
                                    <th>Max Patients</th>
                                    <th>Status (Valid)</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in doctorGroup.OrderBy(s => s.DayOfWeek))
{
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                                                @schedule.DayOfWeek
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">
                                                @DateTime.Today.Add(schedule.StartTime).ToString("hh:mm tt") -
                                                @DateTime.Today.Add(schedule.EndTime).ToString("hh:mm tt")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-info">@schedule.MaxPatients Patients</span>
                                        </td>
                                        <td>
                                            @if (schedule.IsAvailable)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                                    ● Valid / Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                                                    ● Inactive / Suspended
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group">
                                                <a asp-area="Admin" asp-controller="DoctorSchedules" asp-action="Edit" asp-route-id="@schedule.DoctorScheduleId" class="btn btn-sm btn-outline-warning">Edit</a>
                                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@schedule.DoctorScheduleId">
                                                    Delete
                                                </button>
                                            </div>

                                            <div class="modal fade text-start" id="deleteModal-@schedule.DoctorScheduleId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow rounded-3">
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title fw-bold">Confirm Delete</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body p-4 text-center">
                                                            <h5 class="fw-bold">Are you sure?</h5>
<p class="text-muted mb-0">Delete schedule for <strong>@schedule.DayOfWeek</strong>?</p>
                                                        </div>
                                                        <div class="modal-footer bg-light border-0 d-flex justify-content-center gap-2 pb-3">
                                                            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-area="Admin" asp-controller="DoctorSchedules" asp-action="Delete" asp-route-id="@schedule.DoctorScheduleId" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger px-4 fw-semibold">Delete</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-0 fs-5">No doctor schedules found.</p>
            </div>
        </div>
    }
</div>