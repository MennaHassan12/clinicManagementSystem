@model IEnumerable<clinicManagementSystem.Models.BlogPost>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>

   .blog-card-hover {
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    background-color: #fff;
}

.blog-card-hover:hover {
    transform: translateY(-8px);
    box-shadow: 0 1rem 2rem rgba(44, 80, 184, 0.12) !important;
}

.blog-img {
    transition: transform 0.5s ease;
}

.blog-card-hover:hover .blog-img {
    transform: scale(1.08);
}
.animate-fade-up {
    animation: fadeInUp 0.6s ease forwards;
}

.animate-fade-down {
    animation: fadeInDown 0.6s ease forwards;
}


.btn-read-more .bi-arrow-right {
    transition: transform 0.3s ease;
}

.btn-read-more:hover .bi-arrow-right {
    transform: translateX(5px);
}
   
    .btn-hover-effect {
        transition: all 0.3s ease;
    }

    .btn-hover-effect:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

  
    .animated-row:hover img {
        transform: scale(1.08);
        transition: transform 0.3s ease;
    }

    img {
        transition: transform 0.3s ease;
    }
</style>

<div class="animate-admin-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-primary font-weight-bold mb-1">Blog Directory</h1>
            <p class="text-muted mb-0">Manage blog articles and department content</p>
        </div>
        <div>
            <a href="/Admin/Blog/Create" class="btn btn-primary px-4 py-2 font-weight-bold rounded-pill shadow-sm btn-hover-effect">
                <i class="bi bi-plus-lg me-1"></i> Add New Article
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase text-secondary small font-weight-bold border-bottom">
                        <tr>
                            <th class="py-3 px-4 border-0">ARTICLE / AUTHOR</th>
                            <th class="py-3 border-0">CATEGORY</th>
                            <th class="py-3 border-0">DATE</th>
                            <th class="py-3 text-right px-4 border-0" style="width: 180px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">No blog posts found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom animated-row">
                                    <td class="py-3 px-4">
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(item.Image) ? "/images/blogs/default.jpg" : item.Image)"
                                                 class="rounded-circle mr-3 shadow-sm"
                                                 style="width: 48px; height: 48px; object-fit: cover;"
                                                 alt="Article Image" />
                                            <div>
                                                <div class="font-weight-bold text-dark">@item.Title</div>
                                                <small class="text-muted">By @item.Author | ID: #@item.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge badge-info px-3 py-2 font-weight-normal" style="background-color: #e0f7fa; color: #00838f; border-radius: 12px;">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td class="align-middle text-muted">
                                        @item.CreatedDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="align-middle text-right px-4">
                                        <div class="d-inline-flex gap-2">
                                            <a href="/Admin/Blog/Edit/@item.Id" class="btn btn-sm btn-outline-warning rounded-pill mr-2 px-3 btn-hover-effect">
                                                Edit
                                            </a>
                                            <form asp-area="Admin" asp-controller="Blog" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this article?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 btn-hover-effect">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>