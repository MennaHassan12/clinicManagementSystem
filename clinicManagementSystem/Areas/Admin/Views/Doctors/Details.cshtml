@model clinicManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2"></i>Doctor Profile Details</h4>
            <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-light text-primary fw-semibold btn-sm px-3">
                <i class="bi bi-pencil me-1"></i> Edit Profile
            </a>
        </div>
        <div class="card-body p-4">
            <div class="row align-items-start g-4">

                <div class="col-md-4 text-center border-end pe-md-4">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="~/images/doctors/@Model.Image" alt="Doctor Photo" class="img-fluid rounded-4 shadow border mb-3" style="max-height: 260px; width: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-primary-subtle text-primary rounded-4 d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm" style="width: 180px; height: 180px; font-size: 4rem;">
                            @(Model.ApplicationUser?.FullName?.FirstOrDefault() ?? 'D')
                        </div>
                    }
                    <h4 class="fw-bold mb-1 text-dark">Dr. @(Model.ApplicationUser?.FullName ?? "Unnamed")</h4>
                    <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill fs-6 mb-2">
                        @(Model.Department?.Name ?? "No Department")
                    </span>
                    <p class="text-muted small">Doctor ID: #@Model.DoctorId</p>
                </div>

                <div class="col-md-8 ps-md-4">
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6 col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <label class="text-muted small d-block">Phone Number</label>
                                <span class="fw-semibold text-dark">@(Model.ApplicationUser?.PhoneNumber ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <label class="text-muted small d-block">License Number</label>
                                <span class="fw-semibold text-dark">#@Model.LicenseNumber</span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <label class="text-muted small d-block">Consultation Fee</label>
                                <span class="fw-bold text-success">$@Model.ConsultationFee.ToString("F2")</span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <label class="text-muted small d-block">Experience</label>
                                <span class="fw-semibold text-dark">@Model.YearsOfExperience Years</span>
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <label class="text-muted small d-block mb-1 fw-semibold">Biography</label>
<div class="p-3 bg-light rounded-3 text-secondary border">
                                @(string.IsNullOrEmpty(Model.Bio) ? "No biography provided." : Model.Bio)
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-week me-2"></i>Doctor Schedules & Shifts</h5>

                            <a href="/Admin/DoctorSchedules/Create?doctorId=@Model.DoctorId" class="btn btn-outline-primary btn-sm fw-semibold shadow-sm rounded-2">
                                <i class="bi bi-plus-circle me-1"></i> Add Schedule
                            </a>
                        </div>

                        @if (Model.DoctorSchedules != null && Model.DoctorSchedules.Any())
                        {
                            <div class="row g-2">
                                @foreach (var schedule in Model.DoctorSchedules)
                                {
                                    <div class="col-sm-6 col-lg-4">
                                        <div class="p-3 border rounded-3 @(schedule.IsAvailable ? "bg-white border-primary-subtle" : "bg-light text-muted") shadow-sm h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-primary">🗓️ @schedule.DayOfWeek</span>
                                                <span class="badge @(schedule.IsAvailable ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary")">
                                                    @(schedule.IsAvailable ? "Active" : "Inactive")
                                                </span>
                                            </div>
                                            <div class="small fw-semibold text-dark mb-1">
                                                @DateTime.Today.Add(schedule.StartTime).ToString("hh:mm tt") - 
                                                @DateTime.Today.Add(schedule.EndTime).ToString("hh:mm tt")
                                            </div>
                                            <small class="text-muted d-block">Max Patients: <strong>@schedule.MaxPatients</strong></small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <p class="text-muted mb-2">No schedules assigned to this doctor yet.</p>
                                <a href="/Admin/DoctorSchedules/Create?doctorId=@Model.DoctorId" class="btn btn-primary btn-sm fw-semibold">
                                    <i class="bi bi-plus-lg me-1"></i> Add First Schedule
                                </a>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
        <div class="card-footer bg-light p-3 d-flex gap-2 justify-content-end">
            <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-warning px-4 fw-semibold">Edit Profile</a>
            <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
        </div>
    </div>
</div>