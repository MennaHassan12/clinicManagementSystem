@model clinicManagementSystem.ViewModel.DoctorFormVM

@{
    ViewData["Title"] = "Edit Doctor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Doctor Profile</h4>
        </div>
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="Doctors" asp-action="Edit" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="ExistingImagePath" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Doctor Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>


                    <div class="col-md-6">
                        <label class="form-label fw-semibold">License Number</label>
                        <input asp-for="LicenseNumber" type="number" min="1" class="form-control" />
                        <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Department (Optional)</label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>


                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Consultation Fee ($)</label>
                        <input asp-for="ConsultationFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Years Of Experience</label>
                        <input asp-for="YearsOfExperience" type="number" min="0" class="form-control" />
                        <span asp-validation-for="YearsOfExperience" class="text-danger small"></span>
                    </div>


                    <div class="col-12">
                        <label class="form-label fw-semibold">Doctor Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>


                    <div class="col-12">
                        <label class="form-label fw-semibold">Doctor Image</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                            {
                                <img src="~/images/doctors/@Model.ExistingImagePath" class="rounded border shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            <input type="file" asp-for="Photo" class="form-control" accept="image/*" />
                        </div>
                        <span asp-validation-for="Photo" class="text-danger small"></span>
                    </div>


                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 fw-bold">Update Changes</button>
                        <a asp-area="Admin" asp-controller="Doctors" asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}