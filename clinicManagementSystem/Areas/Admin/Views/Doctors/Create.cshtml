@model clinicManagementSystem.ViewModels.DoctorFormVM

@{
    ViewData["Title"] = SharedLocalizer["Add Doctor"];
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>@SharedLocalizer["Add New Doctor"]</h4>
        </div>
        <div class="card-body p-4">

            <form asp-area="Admin" asp-controller="Doctors" asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["Doctor Name"]</label>
                        <input asp-for="Name" class="form-control" placeholder="@SharedLocalizer["Enter doctor full name"]" />
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["Email Address (For Login)"]</label>
                        <input asp-for="Email" class="form-control" placeholder="@SharedLocalizer["doctor@example.com"]" />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["Phone Number"]</label>
                        <input asp-for="Phone" class="form-control" placeholder="@SharedLocalizer["Enter phone number"]" />
                        <span asp-validation-for="Phone" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["License Number"]</label>
                        <input asp-for="LicenseNumber" type="number" min="1" class="form-control" placeholder="@SharedLocalizer["e.g. 102030"]" />
                        <span asp-validation-for="LicenseNumber" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["Department (Optional)"]</label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                            <option value="">-- @SharedLocalizer["Select Department (Optional)"] --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["Consultation Fee ($)"]</label>
                        <input asp-for="ConsultationFee" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="ConsultationFee" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@SharedLocalizer["Years Of Experience"]</label>
                        <input asp-for="YearsOfExperience" type="number" min="0" class="form-control" placeholder="@SharedLocalizer["e.g. 5"]" />
                        <span asp-validation-for="YearsOfExperience" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">@SharedLocalizer["Doctor Bio"]</label>
                        <textarea asp-for="Bio" class="form-control" rows="2" placeholder="@SharedLocalizer["Brief summary about doctor background..."]"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">@SharedLocalizer["Doctor Image"]</label>
                        <input type="file" asp-for="Photo" class="form-control" accept="image/*" />
                        <span asp-validation-for="Photo" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-info py-2 mb-0 small">
                            <i class="bi bi-info-circle me-1"></i> @SharedLocalizer["A reset password link will be generated and sent automatically to the doctor's email for login."]
                        </div>
                    </div>

                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4 fw-bold rounded-pill">@SharedLocalizer["Save Doctor"]</button>
                        <a asp-area="Admin" asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">@SharedLocalizer["Cancel"]</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}