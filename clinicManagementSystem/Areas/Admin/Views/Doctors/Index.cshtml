@model IEnumerable<clinicManagementSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctors Directory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Doctors Directory</h2>
            <p class="text-muted mb-0">Manage doctor profiles and department assignments</p>
        </div>
        <a asp-area="Admin" asp-controller="Doctors" asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
            + Add New Doctor
        </a>
    </div>


    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text" name="searchName" class="form-control" placeholder="Search by doctor name or department..." />
                <button type="submit" class="btn btn-secondary px-4">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </form>
        </div>
    </div>


    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr class="text-secondary small text-uppercase fw-bold">
                            <th class="ps-4 py-3">Doctor</th>
                            <th>Phone</th>
                            <th>License #</th>
                            <th>Department</th>
                            <th>Fee</th>
                            <th>Experience</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Enumerable.Any(Model))
                        {
                            @foreach (var doctor in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(doctor.Image))
                                            {
                                                <img src="~/images/doctors/@doctor.Image" alt="Doctor Photo" class="rounded-circle border shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 48px; height: 48px; font-size: 1.1rem;">
                                                    @(doctor.ApplicationUser?.FullName?.FirstOrDefault() ?? 'D')
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @(doctor.ApplicationUser?.FullName ?? "Dr. Unnamed")
                                                </div>
                                                <small class="text-muted">ID: #@doctor.DoctorId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-dark">@(doctor.ApplicationUser?.PhoneNumber ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">#@doctor.LicenseNumber</span>
                                    </td>
                                    <td>
                                        @if (doctor.Department != null)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill">@doctor.Department.Name</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">No Department</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">$@doctor.ConsultationFee</td>
                                    <td>@doctor.YearsOfExperience Years</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a asp-area="Admin" asp-controller="Doctors" asp-action="Details" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-info">Details</a>
                                            <a asp-area="Admin" asp-controller="Doctors" asp-action="Edit" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-warning">Edit</a>
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@doctor.DoctorId">
                                                Delete
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade text-start" id="deleteModal-@doctor.DoctorId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow rounded-3">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title fw-bold">Confirm Delete</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4 text-center">
                                                        <div class="text-danger mb-3">
                                                            <i class="bi bi-exclamation-triangle-fill display-4"></i>
                                                        </div>
                                                        <h5 class="fw-bold">Are you sure?</h5>
                                                        <p class="text-muted mb-0">
                                                            You are about to delete <strong>@(doctor.ApplicationUser?.FullName ?? "Dr. Unnamed")</strong>. This action cannot be undone.
                                                        </p>
                                                    </div>
                                                    <div class="modal-footer bg-light border-0 d-flex justify-content-center gap-2 pb-3">
                                                        <button type="button" class="btn btn-secondary px-4 rounded-2" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-area="Admin" asp-controller="Doctors" asp-action="Delete" asp-route-id="@doctor.DoctorId" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger px-4 rounded-2 fw-semibold">Yes, Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    No doctors found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>