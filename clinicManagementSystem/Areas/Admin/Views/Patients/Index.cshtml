@model IEnumerable<clinicManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patients Directory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Patients Directory</h2>
            <p class="text-muted mb-0">Manage patients and their basic information</p>
        </div>
        <a asp-area="Admin" asp-controller="Patients" asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
            + Add New Patient
        </a>
    </div>


    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text" name="searchName" class="form-control" placeholder="Search by patient name..." />
                <button type="submit" class="btn btn-secondary px-4">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </form>
        </div>
    </div>


    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr class="text-secondary small text-uppercase fw-bold">
                            <th class="ps-4 py-3">Patient Name</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Birth Date</th>
                            <th>Blood</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Enumerable.Any(Model))
                        {
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark">
                                            @(patient.ApplicationUser?.FullName ?? "Unnamed")
                                        </div>
                                        <small class="text-muted">ID: #@patient.PatientId</small>
                                    </td>
                                    <td>@(patient.ApplicationUser?.PhoneNumber ?? "N/A")</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">@patient.Gender</span>
                                    </td>
                                    <td>@patient.BirthDate.ToString("yyyy-MM-dd")</td>
                                    <td><strong class="text-danger">@patient.BloodType</strong></td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-info">Details</a>
                                            <a asp-action="Edit" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-warning">Edit</a>
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@patient.PatientId">
                                                Delete
                                            </button>
                                        </div>
                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade text-start" id="deleteModal-@patient.PatientId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow rounded-3">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title fw-bold">Confirm Delete</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4 text-center">
                                                        <div class="text-danger mb-3">
                                                            <i class="bi bi-exclamation-triangle-fill display-4"></i>
                                                        </div>
                                                        <h5 class="fw-bold">Are you sure?</h5>
                                                        <p class="text-muted mb-0">
                                                            You are about to delete patient <strong>@(patient.ApplicationUser?.FullName ?? "Unnamed")</strong>. This action cannot be undone.
                                                        </p>
                                                    </div>
                                                    <div class="modal-footer bg-light border-0 d-flex justify-content-center gap-2 pb-3">
                                                        <button type="button" class="btn btn-secondary px-4 rounded-2" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-route-id="@patient.PatientId" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger px-4 rounded-2 fw-semibold">Yes, Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    No patients found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>