@model IEnumerable<clinicManagementSystem.Models.Review>

@{
    ViewData["Title"] = "Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                Reviews
            </h2>

            <p class="text-muted mb-0">
                Manage patient reviews and ratings
            </p>
        </div>


        <a asp-area="Admin"
           asp-controller="Reviews"
           asp-action="Create"
           class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">

            <i class="fas fa-plus me-1"></i>
            Add Review

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fas fa-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="fas fa-star fa-3x text-muted mb-3"></i>

                    <h5>
                        No reviews found.
                    </h5>

                    <p class="text-muted">
                        There are no reviews available yet.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Reviews"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="fas fa-plus me-1"></i>
                        Add First Review

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Appointment
                                </th>

                                <th>
                                    Rating
                                </th>

                                <th>
                                    Comment
                                </th>

                                <th>
                                    Review Date
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var review in Model)
                            {
                                <tr>

                                    <td>
                                        #@review.AppointmentId
                                    </td>


                                    <td>

                                        <span class="badge bg-warning text-dark">
                                            @review.Rating / 5
                                        </span>

                                    </td>


                                    <td>
                                        @(review.Comment ?? "No comment")
                                    </td>


                                    <td>
                                        @review.ReviewDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Reviews"
                                               asp-action="Edit"
                                               asp-route-id="@review.ReviewId"
                                               class="btn btn-sm btn-warning rounded-3 px-3">

                                                <i class="fas fa-edit me-1"></i>
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Reviews"
                                               asp-action="Delete"
                                               asp-route-id="@review.ReviewId"
                                               class="btn btn-sm btn-danger rounded-3 px-3">

                                                <i class="fas fa-trash me-1"></i>
                                                Delete
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>