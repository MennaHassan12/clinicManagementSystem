@model IEnumerable<clinicManagementSystem.Models.Review>

@{
    ViewData["Title"] = SharedLocalizer["Reviews"];
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">@SharedLocalizer["Reviews"]</h2>
            <p class="text-muted mb-0">
                @SharedLocalizer["View and manage patient reviews"]
            </p>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <h5>@SharedLocalizer["No Reviews Found"]</h5>

                <p class="text-muted mb-0">
                    @SharedLocalizer["There are no patient reviews yet."]
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr class="text-secondary small text-uppercase fw-bold">
                                <th>@SharedLocalizer["Doctor"]</th>
                                <th>@SharedLocalizer["Patient"]</th>
                                <th>@SharedLocalizer["Rating"]</th>
                                <th>@SharedLocalizer["Comment"]</th>
                                <th>@SharedLocalizer["Review Date"]</th>
                                <th class="text-center">@SharedLocalizer["ACTIONS"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var review in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @(review.Appointment?.Doctor?.ApplicationUser?.FullName ?? $"{SharedLocalizer["Doctor"]} #{review.Appointment?.DoctorId}")
                                        </div>
                                        <small class="text-muted">
                                            @(review.Appointment?.Doctor?.Department?.Name ?? SharedLocalizer["Department"].Value)
                                        </small>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @(review.Appointment?.Patient?.ApplicationUser?.FullName ?? $"{SharedLocalizer["Patient"]} #{review.Appointment?.PatientId}")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold me-2 text-dark">
                                                @review.Rating / 5
                                            </span>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(review.Comment)
                                            ? SharedLocalizer["No comment"].Value
                                            : review.Comment)
                                    </td>

                                    <td>
                                        @review.ReviewDate.ToString("dd/MM/yyyy hh:mm tt")
                                    </td>

                                    <td class="text-center">

                                        <a asp-area="Admin"
                                           asp-controller="Reviews"
                                           asp-action="Delete"
                                           asp-route-id="@review.ReviewId"
                                           class="btn btn-danger btn-sm rounded-pill">

                                            @SharedLocalizer["Delete"]

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>