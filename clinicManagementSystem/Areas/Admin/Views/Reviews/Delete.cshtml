@model clinicManagementSystem.Models.Review

@{
    ViewData["Title"] = "Delete Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Delete Review</h2>
        <p class="text-muted">
            Are you sure you want to delete this review?
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Review ID</dt>
                <dd class="col-sm-9">
                    #@Model.ReviewId
                </dd>

                <dt class="col-sm-3">Appointment</dt>
                <dd class="col-sm-9">
                    #@Model.AppointmentId
                </dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">

                    <span class="fw-semibold me-2">
                        @Model.Rating / 5
                    </span>

                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.Rating)
                        {
                            <i class="bi bi-star-fill text-warning"></i>
                        }
                        else
                        {
                            <i class="bi bi-star text-muted"></i>
                        }
                    }

                </dd>

                <dt class="col-sm-3">Comment</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Comment)
                        ? "No comment"
                        : Model.Comment)
                </dd>

                <dt class="col-sm-3">Review Date</dt>
                <dd class="col-sm-9">
                    @Model.ReviewDate.ToString("dd/MM/yyyy")
                </dd>

            </dl>

            <form asp-area="Admin"
                  asp-controller="Reviews"
                  asp-action="Delete"
                  asp-route-id="@Model.ReviewId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger rounded-3">
                    <i class="bi bi-trash"></i>
                    Yes, Delete
                </button>

                <a asp-area="Admin"
                   asp-controller="Reviews"
                   asp-action="Index"
                   class="btn btn-secondary rounded-3">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>