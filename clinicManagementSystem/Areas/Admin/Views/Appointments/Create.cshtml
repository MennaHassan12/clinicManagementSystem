@model clinicManagementSystem.ViewModels.PatientBookingVM

@{
    ViewData["Title"] = "Add New Patient & Book Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h3 class="fw-bold text-primary mb-4">Add New Patient & Book Appointment</h3>

                @if (TempData["error_notification"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["error_notification"]</div>
                }

                <form asp-area="Admin" asp-controller="Appointments" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Patient Info Section -->
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Patient Information</h5>

                    <div class="mb-3">
                        <label asp-for="PatientName" class="form-label fw-bold">Patient Name *</label>
                        <input asp-for="PatientName" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="PatientName" class="text-danger small fw-bold d-block mt-1"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PatientPhone" class="form-label fw-bold">Phone Number *</label>
                            <input asp-for="PatientPhone" class="form-control" placeholder="e.g. 01012345678" />
                            <span asp-validation-for="PatientPhone" class="text-danger small fw-bold d-block mt-1"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="BirthDate" class="form-label fw-bold">Date of Birth *</label>
                            <input asp-for="BirthDate" type="date" class="form-control" />
                            <span asp-validation-for="BirthDate" class="text-danger small fw-bold d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PatientEmail" class="form-label fw-bold">Email Address *</label>
                        <input asp-for="PatientEmail" type="email" class="form-control" placeholder="example@domain.com" />
                        <span asp-validation-for="PatientEmail" class="text-danger small fw-bold d-block mt-1"></span>
                    </div>

                    <!-- Appointment Details Section -->
                    <h5 class="fw-bold text-secondary mt-4 mb-3 border-bottom pb-2">Appointment Details</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Doctor *</label>
                        <select id="DoctorId" name="DoctorId" asp-for="DoctorId" asp-items="Model.Doctors" class="form-select">
                            <option value="">-- Select Doctor --</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger small fw-bold d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Working Shift / Day *</label>
                        <select id="DoctorScheduleId" name="DoctorScheduleId" asp-for="DoctorScheduleId" class="form-select">
                            <option value="">-- Select Shift --</option>
                        </select>
                        <span asp-validation-for="DoctorScheduleId" class="text-danger small fw-bold d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Date *</label>
                        <input type="date" name="AppointmentDate" id="AppointmentDate" asp-for="AppointmentDate" class="form-control" />
                        <span asp-validation-for="AppointmentDate" class="text-danger small fw-bold d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Time Slot *</label>
                        <select id="AppointmentTime" name="AppointmentTime" asp-for="AppointmentTime" class="form-select">
                            <option value="">-- Select Time Slot --</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger small fw-bold d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">Notes / Medical Comments (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter additional notes..."></textarea>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                            Confirm & Book
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/adminCreateAppointment.js" asp-append-version="true"></script>
}