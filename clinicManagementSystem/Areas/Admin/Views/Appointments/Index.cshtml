@model IEnumerable<clinicManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Manage All Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int totalAppointments = Model?.Count() ?? 0;
    int pendingCount = Model?.Count(a => a.Status == clinicManagementSystem.Models.AppointmentStatus.Pending) ?? 0;
    int confirmedCount = Model?.Count(a => a.Status == clinicManagementSystem.Models.AppointmentStatus.Confirmed) ?? 0;
    int completedCount = Model?.Count(a => a.Status == clinicManagementSystem.Models.AppointmentStatus.Completed) ?? 0;
    int cancelledCount = Model?.Count(a => a.Status == clinicManagementSystem.Models.AppointmentStatus.Cancelled) ?? 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-calendar-check me-2 text-primary"></i>Appointment Dashboard</h2>
            <p class="text-muted mb-0">Overview and management of all clinic appointments</p>
        </div>

        <div>
            <a asp-area="Admin" asp-controller="Appointments" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Book New Appointment</span>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">TOTAL BOOKINGS</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalAppointments</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">PENDING</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@pendingCount</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">CONFIRMED</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@confirmedCount</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">COMPLETED</span>
<h3 class="fw-bold text-info mb-0 mt-1">@completedCount</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle">
                        <i class="bi bi-award fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-area="Admin" asp-controller="Appointments" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input type="text" name="searchString" class="form-control rounded-pill px-3" placeholder="Search patient, doctor, or notes..." value="@Context.Request.Query["searchString"]" />
                </div>
                <div class="col-md-3">
                    <select name="doctorId" class="form-select rounded-pill" asp-items="ViewBag.Doctors">
                        <option value="">-- All Doctors --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="departmentId" class="form-select rounded-pill" asp-items="ViewBag.Departments">
                        <option value="">-- All Departments --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select rounded-pill">
                        <option value="">-- All Statuses --</option>
                        <option value="0">Pending</option>
                        <option value="1">Confirmed</option>
                        <option value="2">Completed</option>
                        <option value="3">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill w-100 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-filter"></i>
                        <span>Filter</span>
                    </button>
                    
                    <a asp-area="Admin" asp-controller="Appointments" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 d-flex align-items-center justify-content-center" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span class="d-none d-xl-inline ms-1">Reset</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 px-4">PATIENT</th>
                        <th class="py-3 px-4">DOCTOR & DEPT</th>
                        <th class="py-3 px-4">DATE & TIME</th>
                        <th class="py-3 px-4">NOTES</th>
                        <th class="py-3 px-4">STATUS</th>
                        <th class="py-3 px-4 text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            string patientDisplayName = item.Patient?.ApplicationUser?.FullName ?? $"Patient #{item.PatientId}";
                            string doctorDisplayName = item.Doctor?.ApplicationUser?.FullName ?? $"Dr. #{item.DoctorId}";
                            string departmentName = item.Doctor?.Department?.Name ?? "General";
                            string actualNotes = "-";
if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                if (item.Notes.StartsWith("Patient:"))
                                {
                                    var namePart = item.Notes.Split('|')[0].Split('-')[0].Replace("Patient:", "").Trim();
                                    
                                    if (namePart.Contains('('))
                                    {
                                        namePart = namePart.Split('(')[0].Trim();
                                    }

                                    if (!string.IsNullOrWhiteSpace(namePart))
                                    {
                                        patientDisplayName = namePart;
                                    }

                                    if (item.Notes.Contains("Notes:"))
                                    {
                                        actualNotes = item.Notes.Split("Notes:")[1].Trim();
                                    }
                                }
                                else
                                {
                                    actualNotes = item.Notes;
                                }
                            }

                            <tr>
                                <td class="px-4 fw-bold text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                            @(patientDisplayName.Length > 0 ? patientDisplayName[0].ToString().ToUpper() : "P")
                                        </div>
                                        <span>@patientDisplayName</span>
                                    </div>
                                </td>
                                <td class="px-4">
                                    <div class="fw-semibold text-dark">@doctorDisplayName</div>
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill small">@departmentName</span>
                                </td>
                                <td class="px-4">
                                    <div class="fw-semibold">@item.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                    <small class="text-muted">@DateTime.Today.Add(item.AppointmentTime.ToTimeSpan()).ToString("hh:mm tt")</small>
                                </td>
                                <td class="px-4 text-muted small" style="max-width: 200px;">
                                    <span class="d-inline-block text-truncate" style="max-width: 180px;" title="@actualNotes">
                                        @actualNotes
                                    </span>
                                </td>
                                <td class="px-4">
                                    @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Pending)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill">Pending</span>
                                    }
                                    else if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Confirmed)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">Confirmed</span>
}
                                    else if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Completed)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">Cancelled</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Pending)
                                        {
                                            <form asp-area="Admin" asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.AppointmentId" />
                                                <input type="hidden" name="status" value="@((int)clinicManagementSystem.Models.AppointmentStatus.Confirmed)" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" title="Confirm Appointment">Confirm</button>
                                            </form>
                                        }

                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Pending || item.Status == clinicManagementSystem.Models.AppointmentStatus.Confirmed)
                                        {
                                            <form asp-area="Admin" asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.AppointmentId" />
                                                <input type="hidden" name="status" value="@((int)clinicManagementSystem.Models.AppointmentStatus.Cancelled)" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Cancel Appointment">Cancel</button>
                                            </form>
                                        }

                                        <form asp-area="Admin" asp-controller="Appointments" asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to permanently delete this appointment and its associated records?');">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                No appointments found matching your search criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
