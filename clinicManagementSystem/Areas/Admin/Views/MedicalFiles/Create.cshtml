@model clinicManagementSystem.ViewModels.MedicalFileVM

@{
    ViewData["Title"] = "Create Medical File";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var medicalRecords =
        ViewBag.MedicalRecords as IEnumerable<dynamic>;
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                Add Medical File
            </h2>

            <p class="text-muted mb-0">
                Upload a PDF or image to a medical record
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MedicalFiles"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-3">

            <i class="fas fa-arrow-left me-1"></i>
            Back to Medical Files

        </a>

    </div>


    <!-- Card -->
    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="MedicalFiles"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row g-4">


                    <!-- Medical Record -->
                    <div class="col-md-6">

                        <label asp-for="MedicalRecordId"
                               class="form-label fw-semibold">
                            Medical Record
                        </label>

                        <select asp-for="MedicalRecordId"
                                class="form-select">

                            <option value="0">
                                -- Select Medical Record --
                            </option>

                            @if (medicalRecords != null)
                            {
                                foreach (var record in medicalRecords)
                                {
                                    <option value="@record.Id">
                                        @record.Display
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="MedicalRecordId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Upload Date -->
                    <div class="col-md-6">

                        <label asp-for="UploadDate"
                               class="form-label fw-semibold">
                            Upload Date
                        </label>

                        <input asp-for="UploadDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="UploadDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- File Upload -->
                    <div class="col-12">

                        <label asp-for="File"
                               class="form-label fw-semibold">
                            Medical File
                        </label>

                        <input asp-for="File"
                               type="file"
                               class="form-control"
                               accept=".pdf,.jpg,.jpeg,.png" />

                        <div class="form-text mt-2">
                            <i class="fas fa-info-circle me-1"></i>
                            Allowed files: PDF, JPG, JPEG and PNG.
                            Maximum size: 10 MB.
                        </div>

                        <span asp-validation-for="File"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-area="Admin"
                       asp-controller="MedicalFiles"
                       asp-action="Index"
                       class="btn btn-secondary px-4">

                        <i class="fas fa-times me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="fas fa-upload me-1"></i>
                        Upload File

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}