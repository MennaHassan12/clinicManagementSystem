@model clinicManagementSystem.Models.MedicalFile

@{
    ViewData["Title"] = "Edit Medical File";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var medicalRecords =
        ViewBag.MedicalRecords as IEnumerable<dynamic>;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                Edit Medical File
            </h2>

            <p class="text-muted mb-0">
                Update medical record link, date, or replace the file
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MedicalFiles"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-3">

            <i class="fas fa-arrow-left me-1"></i>
            Back to Medical Files

        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="MedicalFiles"
                  asp-action="Edit"
                  asp-route-id="@Model.MedicalFileId"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MedicalFileId" />

                <!-- Medical Record -->
                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Medical Record
                    </label>

                    <select name="MedicalRecordId"
                            class="form-select">

                        <option value="">
                            -- Select Medical Record --
                        </option>

                        @if (medicalRecords != null)
                        {
                            foreach (var record in medicalRecords)
                            {
                                <option value="@record.Id"
                                        selected="@(Model.MedicalRecordId == record.Id ? "selected" : null)">
                                    @record.Display
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Current File -->
                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Current File
                    </label>

                    <div class="p-3 bg-light rounded-3">

                        <i class="fas fa-file-medical text-primary me-2"></i>

                        <span>
                            @Model.FileName
                        </span>

                        <span class="badge bg-secondary ms-2">
                            @Model.FileType
                        </span>

                    </div>

                </div>


                <!-- Replace File -->
                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Replace File <small class="text-muted fw-normal">(optional)</small>
                    </label>

                    <input type="file"
                           name="uploadedFile"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />

                    <div class="form-text mt-2">
                        <i class="fas fa-info-circle me-1"></i>
                        Leave empty to keep the current file.
                        Allowed files: PDF, JPG, JPEG and PNG.
                        Maximum size: 10 MB.
                    </div>

                </div>


                <!-- Upload Date -->
                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Upload Date
                    </label>

                    <input type="date"
                           name="UploadDate"
                           value="@Model.UploadDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>


                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-area="Admin"
                       asp-controller="MedicalFiles"
                       asp-action="Index"
                       class="btn btn-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="fas fa-save me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>