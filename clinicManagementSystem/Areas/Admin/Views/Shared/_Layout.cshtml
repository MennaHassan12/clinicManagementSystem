@using Microsoft.AspNetCore.Identity
@using clinicManagementSystem.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<clinicManagementSystem.SharedResource> SharedLocalizer
@inject UserManager<ApplicationUser> UserManager

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isRtl = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HealthCare Portal</title>

    <!-- Bootstrap 5 -->
    @if (isRtl)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Toastr -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />

    <style>
        body {
            background-color: #f6f9fc;
            font-family: Arial, sans-serif;
        }

        .admin-sidebar {
            width: 260px;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #ffffff;
            border-right: 1px solid #e9eef5;
            z-index: 1030;
        }

        html[dir="rtl"] .admin-sidebar {
            left: auto;
            right: 0;
            border-right: none;
            border-left: 1px solid #e9eef5;
        }

        .admin-brand {
            height: 75px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            text-decoration: none;
            color: #0d6efd;
            font-size: 21px;
            font-weight: 700;
            border-bottom: 1px solid #eef2f7;
        }

        .admin-brand i {
            font-size: 28px;
        }

        .admin-user {
            padding: 22px 20px;
            border-bottom: 1px solid #eef2f7;
        }

        .admin-user-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(13, 110, 253, 0.1);
            color: #0d6efd;
            border-radius: 50%;
            font-size: 22px;
        }

        .admin-menu {
            padding: 18px 14px;
        }

        .admin-menu-title {
            font-size: 11px;
            color: #98a2b3;
            font-weight: 700;
            text-transform: uppercase;
            padding: 0 12px;
            margin-bottom: 10px;
        }

        .admin-menu .nav-link {
            color: #667085;
            padding: 11px 14px;
            border-radius: 12px;
            margin-bottom: 5px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: 0.2s;
        }

        .admin-menu .nav-link i {
            width: 20px;
            text-align: center;
            font-size: 17px;
        }

        .admin-menu .nav-link:hover {
            background: #f0f6ff;
            color: #0d6efd;
        }

        .admin-menu .nav-link.active {
            background: #eaf3ff;
            color: #0d6efd;
            font-weight: 600;
        }

        .admin-logout {
            color: #dc3545 !important;
        }

        .admin-logout:hover {
            background: #fff1f2 !important;
            color: #dc3545 !important;
        }

        .admin-main {
            margin-left: 260px;
            min-height: 100vh;
        }

        html[dir="rtl"] .admin-main {
            margin-left: 0;
            margin-right: 260px;
        }

        .admin-topbar {
            height: 75px;
            background: #ffffff;
            border-bottom: 1px solid #e9eef5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .admin-page-content {
            padding: 28px 30px;
        }

        .admin-user-menu {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #344054;
            font-weight: 600;
        }

        .admin-user-menu i {
            color: #0d6efd;
            font-size: 24px;
        }

        .mobile-menu-btn {
            display: none;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
            }

            html[dir="rtl"] .admin-sidebar {
                transform: translateX(100%);
            }

            .admin-sidebar.show {
                transform: translateX(0) !important;
            }

            .admin-main {
                margin-left: 0;
                margin-right: 0;
            }

            .mobile-menu-btn {
                display: inline-flex;
            }

            .admin-topbar {
                padding: 0 18px;
            }

            .admin-page-content {
                padding: 20px 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="admin-brand">
            <i class="bi bi-heart-pulse-fill me-2"></i>
            <span>@SharedLocalizer["HealthCare"]</span>
        </a>

        <!-- User -->
        <div class="admin-user">
            <div class="d-flex align-items-center gap-3">

                <div class="admin-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate">
                        @(User.Identity?.Name ?? SharedLocalizer["Administrator"].Value)
                    </div>
                    <small class="text-muted">
                        @SharedLocalizer["Administrator"]
                    </small>
                </div>

            </div>
        </div>

        <!-- Menu -->
        <nav class="admin-menu">

            <div class="admin-menu-title">
                @SharedLocalizer["Pages"]
            </div>

            <ul class="nav flex-column">

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>@SharedLocalizer["Dashboard"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="Departments"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departments" ? "active" : "")">
                        <i class="bi bi-hospital"></i>
                        <span>@SharedLocalizer["Departments"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="Doctors"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctors" ? "active" : "")">
                        <i class="bi bi-person-badge"></i>
                        <span>@SharedLocalizer["Doctors"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="DoctorSchedules"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DoctorSchedules" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>@SharedLocalizer["Opening Hours"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="Appointments"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>@SharedLocalizer["Appointments"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="MedicalFiles"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalFiles" ? "active" : "")">
                        <i class="bi bi-file-earmark-medical"></i>
                        <span>@SharedLocalizer["Medical Files"]</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="Admin"
                       asp-controller="Reviews"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")">
                        <i class="bi bi-star"></i>
                        <span>@SharedLocalizer["Reviews"]</span>
                    </a>
                </li>

            </ul>

            <div class="admin-menu-title mt-4">
                @SharedLocalizer["My Profile"]
            </div>

            <form asp-area="Identity"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="nav-link admin-logout border-0 bg-transparent w-100 text-start">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>@SharedLocalizer["Logout"]</span>
                </button>

            </form>

        </nav>

    </aside>

    <!-- Main -->
    <div class="admin-main">

        <!-- Topbar -->
        <header class="admin-topbar">

            <div class="d-flex align-items-center gap-3">

                <button type="button"
                        class="btn btn-light rounded-3 mobile-menu-btn"
                        id="sidebarToggle">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div>
                    <h6 class="fw-bold mb-0">
                        @ViewData["Title"]
                    </h6>

                    <small class="text-muted">
                        @SharedLocalizer["Clinic Management System"]
                    </small>
                </div>

            </div>

            <div class="d-flex align-items-center gap-3">
                <partial name="_SelectLanguagePartial" />
                <div class="admin-user-menu">
                    <i class="bi bi-person-circle"></i>
                    <span class="d-none d-sm-inline">
                        @(User.Identity?.Name ?? SharedLocalizer["Administrator"].Value)
                    </span>
                </div>
            </div>

        </header>

        <!-- Page -->
        <main class="admin-page-content">

            <partial name="_NotificationPartial" />

            @RenderBody()

        </main>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const sidebar = document.getElementById("adminSidebar");
            const toggle = document.getElementById("sidebarToggle");

            if (toggle) {
                toggle.addEventListener("click", function () {
                    sidebar.classList.toggle("show");
                });
            }

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>