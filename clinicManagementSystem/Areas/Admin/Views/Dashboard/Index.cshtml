@model clinicManagementSystem.Areas.Admin.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = SharedLocalizer["Admin Dashboard"];
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@SharedLocalizer["Admin Dashboard"]</h2>
            <p class="text-muted mb-0">
                @SharedLocalizer["Overview of your clinic management system"]
            </p>
        </div>

        <div class="text-muted">
            <i class="bi bi-calendar3 me-1"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">@SharedLocalizer["Patients"]</p>
                            <h3 class="fw-bold mb-0">@Model.TotalPatients</h3>
                        </div>
                        <div class="fs-2 text-primary">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">@SharedLocalizer["Doctors"]</p>
                            <h3 class="fw-bold mb-0">@Model.TotalDoctors</h3>
                        </div>
                        <div class="fs-2 text-success">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">@SharedLocalizer["Departments"]</p>
                            <h3 class="fw-bold mb-0">@Model.TotalDepartments</h3>
                        </div>
                        <div class="fs-2 text-info">
                            <i class="bi bi-hospital"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">@SharedLocalizer["Appointments"]</p>
                            <h3 class="fw-bold mb-0">@Model.TotalAppointments</h3>
                        </div>
                        <div class="fs-2 text-warning">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">@SharedLocalizer["Medical Files"]</p>
                            <h3 class="fw-bold mb-0">@Model.TotalMedicalFiles</h3>
                        </div>
                        <div class="fs-2 text-danger">
                            <i class="bi bi-file-earmark-medical"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">@SharedLocalizer["Reviews"]</p>
                            <h3 class="fw-bold mb-0">@Model.TotalReviews</h3>
                            <small class="text-muted">
                                ★ @Model.AverageRating.ToString("0.0") / 5
                            </small>
                        </div>
                        <div class="fs-2 text-warning">
                            <i class="bi bi-star-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Today's Appointments -->
    <div class="row g-4 mb-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">@SharedLocalizer["Today's Appointments"]</h5>
                            <p class="text-muted mb-0">
                                @Model.TodayAppointments @SharedLocalizer["appointment(s) today"]
                            </p>
                        </div>
                        <i class="bi bi-calendar2-week fs-3 text-primary"></i>
                    </div>
                </div>

                <div class="card-body px-4">
                    @if (Model.TodayAppointmentsList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>@SharedLocalizer["Patient"]</th>
                                        <th>@SharedLocalizer["Doctor"]</th>
                                        <th>@SharedLocalizer["Time"]</th>
                                        <th>@SharedLocalizer["STATUS"]</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var appointment in Model.TodayAppointmentsList)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @(appointment.Patient?.ApplicationUser?.FullName ?? SharedLocalizer["Unknown"].Value)
                                                </strong>
                                            </td>

                                            <td>
                                                @(appointment.Doctor?.ApplicationUser?.FullName ?? SharedLocalizer["Unknown"].Value)
                                            </td>

                                            <td>
                                                @appointment.AppointmentTime.ToString("hh\\:mm")
                                            </td>

                                            <td>
                                                @switch (appointment.Status)
                                                {
                                                    case AppointmentStatus.Confirmed:
                                                        <span class="badge rounded-pill bg-success-subtle text-success">
                                                            @SharedLocalizer["Confirmed"]
                                                        </span>
                                                        break;

                                                    case AppointmentStatus.Pending:
                                                        <span class="badge rounded-pill bg-warning-subtle text-warning">
                                                            @SharedLocalizer["Pending"]
                                                        </span>
                                                        break;

                                                    case AppointmentStatus.Completed:
                                                        <span class="badge rounded-pill bg-info-subtle text-info">
                                                            @SharedLocalizer["Completed"]
                                                        </span>
                                                        break;

                                                    case AppointmentStatus.Cancelled:
                                                        <span class="badge rounded-pill bg-danger-subtle text-danger">
                                                            @SharedLocalizer["Cancelled"]
                                                        </span>
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="text-muted mt-3 mb-0">
                                @SharedLocalizer["No appointments scheduled for today."]
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Today's Status -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">@SharedLocalizer["Today's Overview"]</h5>
                </div>

                <div class="card-body px-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted">
                            <i class="bi bi-check-circle me-2"></i>
                            @SharedLocalizer["Confirmed"]
                        </span>
                        <strong>@Model.TodayConfirmed</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted">
                            <i class="bi bi-clock me-2"></i>
                            @SharedLocalizer["Pending"]
                        </span>
                        <strong>@Model.TodayPending</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted">
                            <i class="bi bi-check2-all me-2"></i>
                            @SharedLocalizer["Completed"]
                        </span>
                        <strong>@Model.TodayCompleted</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">
                            <i class="bi bi-x-circle me-2"></i>
                            @SharedLocalizer["Cancelled"]
                        </span>
                        <strong>@Model.TodayCancelled</strong>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Departments + Reviews -->
    <div class="row g-4">

        <!-- Departments -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-1">@SharedLocalizer["Departments"]</h5>
                    <p class="text-muted mb-0">
                        @SharedLocalizer["Doctors by department"]
                    </p>
                </div>

                <div class="card-body px-4">

                    @foreach (var department in Model.DepartmentStats)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>
                                <i class="bi bi-hospital me-2 text-primary"></i>
                                @department.DepartmentName
                            </span>

                            <span class="badge rounded-pill bg-primary-subtle text-primary">
                                @department.DoctorCount @SharedLocalizer["Doctors"]
                            </span>
                        </div>
                    }

                    @if (!Model.DepartmentStats.Any())
                    {
                        <p class="text-muted text-center py-3">
                            @SharedLocalizer["No departments available."]
                        </p>
                    }

                </div>
            </div>
        </div>

        <!-- Recent Reviews -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-1">@SharedLocalizer["Recent Reviews"]</h5>
                    <p class="text-muted mb-0">
                        @SharedLocalizer["Latest patient feedback"]
                    </p>
                </div>

                <div class="card-body px-4">

                    @foreach (var review in Model.RecentReviews)
                    {
                        <div class="border-bottom pb-3 mb-3">

                            <div class="d-flex justify-content-between">
                                <strong>
                                    @(review.Appointment?.Patient?.ApplicationUser?.FullName ?? SharedLocalizer["Patient"].Value)
                                </strong>

                                <span class="text-warning">
                                    ★ @review.Rating
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-muted mb-1 mt-2">
                                    @review.Comment
                                </p>
                            }

                            <small class="text-muted">
                                @review.ReviewDate.ToString("dd MMM yyyy")
                            </small>

                        </div>
                    }

                    @if (!Model.RecentReviews.Any())
                    {
                        <p class="text-muted text-center py-3">
                            @SharedLocalizer["No reviews available."]
                        </p>
                    }

                </div>
            </div>
        </div>

    </div>

</div>