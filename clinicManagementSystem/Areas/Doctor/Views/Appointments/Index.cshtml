@model IEnumerable<clinicManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Doctor Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int currentDoctorId = ViewBag.DoctorId ?? 1;
    string searchString = ViewBag.SearchString as string ?? "";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">My Patient Appointments</h2>
            <p class="text-muted mb-0">Manage and update your patient bookings</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form action="/Doctor/Appointments/Index" method="get" class="row g-2 align-items-center">
                <input type="hidden" name="doctorId" value="@currentDoctorId" />

                <div class="col-8 col-md-9">
                    <input type="text" name="searchString" class="form-control rounded-pill px-3" placeholder="Search by patient name or notes..." value="@searchString" />
                </div>

                <div class="col-4 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill flex-grow-1 fw-semibold">
                        <i class="bi bi-search me-1"></i> Search
                    </button>

                    <a href="/Doctor/Appointments/Index?doctorId=@currentDoctorId"
                       class="btn btn-outline-secondary rounded-pill d-flex align-items-center justify-content-center fw-bold"
                       style="min-width: 45px; height: 38px;"
                       title="Reset Search">
                        ↺
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 px-4">PATIENT</th>
                        <th class="py-3 px-4">DATE & TIME</th>
                        <th class="py-3 px-4">NOTES</th>
                        <th class="py-3 px-4">STATUS</th>
                        <th class="py-3 px-4 text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model.OrderByDescending(a => a.AppointmentDate).ThenByDescending(a => a.AppointmentTime))
                        {
                            string patientDisplayName = item.Patient?.ApplicationUser?.FullName ?? $"Patient #{item.PatientId}";
                            string actualNotes = "-";

                            if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                if (item.Notes.StartsWith("Patient:"))
                                {
                                    var namePart = item.Notes.Split('|')[0].Split('-')[0].Replace("Patient:", "").Trim();

                                    if (namePart.Contains('('))
                                    {
                                        namePart = namePart.Split('(')[0].Trim();
                                    }

                                    if (!string.IsNullOrWhiteSpace(namePart))
                                    {
                                        patientDisplayName = namePart;
                                    }

                                    if (item.Notes.Contains("Notes:"))
                                    {
                                        actualNotes = item.Notes.Split("Notes:")[1].Trim();
                                    }
                                }
                                else
                                {
                                    actualNotes = item.Notes;
                                }
                            }

                            <tr>
                                <td class="px-4 fw-bold text-dark">
                                    @patientDisplayName
                                </td>
                                <td class="px-4">
                                    <div class="fw-semibold">@item.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                    <small class="text-muted">@DateTime.Today.Add(item.AppointmentTime.ToTimeSpan()).ToString("hh:mm tt")</small>
                                </td>
                                <td class="px-4 text-muted small">
                                    @actualNotes
                                </td>
                                <td class="px-4">
                                    @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Pending)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill">Pending</span>
                                    }
                                    else if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Confirmed)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">Confirmed</span>
                                    }
                                    else if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Completed)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">Cancelled</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Pending)
                                        {
                                            <form action="/Doctor/Appointments/ChangeStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.AppointmentId" />
                                                <input type="hidden" name="status" value="@((int)clinicManagementSystem.Models.AppointmentStatus.Confirmed)" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Confirm</button>
                                            </form>
                                        }

                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Confirmed)
                                        {
                                            <a href="/Doctor/MedicalRecords/Create?appointmentId=@item.AppointmentId&doctorId=@currentDoctorId" class="btn btn-sm btn-primary rounded-pill px-3">
                                                Add Medical Record
                                            </a>
                                        }
                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Completed)
                                        {
                                            <a href="/Doctor/MedicalRecords/Details?appointmentId=@item.AppointmentId" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                👁 View Record
                                            </a>
                                        }

                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Pending || item.Status == clinicManagementSystem.Models.AppointmentStatus.Confirmed)
                                        {
                                            <form action="/Doctor/Appointments/ChangeStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.AppointmentId" />
                                                <input type="hidden" name="status" value="@((int)clinicManagementSystem.Models.AppointmentStatus.Cancelled)" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">Cancel</button>
                                            </form>
                                        }

                                        @if (item.Status == clinicManagementSystem.Models.AppointmentStatus.Cancelled || item.Status == clinicManagementSystem.Models.AppointmentStatus.Completed)
                                        {
                                            <form action="/Doctor/Appointments/Delete" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.AppointmentId" />
                                                <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to delete this appointment?');">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No appointments found matching your search.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
