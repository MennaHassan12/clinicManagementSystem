@model IEnumerable<clinicManagementSystem.Models.Review>

@{
    ViewData["Title"] = "Patient Reviews & Ratings";
    Layout = "~/Areas/Doctor/Views/Shared/_Layout.cshtml";
    double avgRating = ViewBag.AverageRating ?? 0.0;
    int totalReviews = ViewBag.TotalReviews ?? 0;
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                ⭐ Patient Reviews & Feedback
            </h2>
            <p class="text-muted mb-0">
                Track your ratings and feedback submitted by patients after completed appointments
            </p>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="d-block text-white-50 small text-uppercase fw-semibold mb-1">Average Rating</span>
                        <h2 class="display-6 fw-bold mb-0">@avgRating.ToString("0.0") <small class="fs-5">/ 5.0</small></h2>
                        <div class="mt-2 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(avgRating))
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-white-50"></i>
                                }
                            }
                        </div>
                    </div>
                    <div class="fs-1 opacity-75">
                        ⭐
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="d-block text-muted small text-uppercase fw-semibold mb-1">Total Reviews</span>
                        <h2 class="display-6 fw-bold text-dark mb-0">@totalReviews</h2>
                        <small class="text-success fw-semibold">Patient consultations rated</small>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                        <i class="bi bi-chat-heart"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="card-body">
                    <span class="d-block text-muted small text-uppercase fw-semibold mb-2">Rating Breakdown</span>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>5 Stars: <b>@ViewBag.FiveStarCount</b></span>
                        <span>4 Stars: <b>@ViewBag.FourStarCount</b></span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>3 Stars: <b>@ViewBag.ThreeStarCount</b></span>
                        <span>1-2 Stars: <b>@(ViewBag.TwoStarCount + ViewBag.OneStarCount)</b></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5">
                <div class="fs-1 mb-3">💬</div>
                <h5 class="fw-bold">No Reviews Yet</h5>
                <p class="text-muted mb-0">
                    Patient reviews will appear here once your patients rate their completed visits.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Recent Feedback</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-secondary small text-uppercase fw-bold">
                                <th class="ps-4 py-3">Patient</th>
                                <th>Appointment Date</th>
                                <th>Rating</th>
                                <th>Comment</th>
                                <th class="pe-4 text-end">Review Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        @(review.Appointment?.Patient?.ApplicationUser?.FullName ?? $"Patient #{review.Appointment?.PatientId}")
                                    </td>
                                    <td>
                                        @review.Appointment?.AppointmentDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold me-2 text-dark">@review.Rating / 5</span>
                                            <span class="text-warning">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-muted"></i>
                                                    }
                                                }
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                                        {
                                            <span class="text-dark">"@review.Comment"</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No comment provided</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end text-muted small">
                                        @review.ReviewDate.ToString("dd/MM/yyyy hh:mm tt")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>