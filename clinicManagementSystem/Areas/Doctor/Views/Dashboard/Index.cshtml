@model clinicManagementSystem.Areas.Doctor.ViewModels.DoctorDashboardVM

@{
    ViewData["Title"] = SharedLocalizer["Doctor Dashboard"];
    Layout = "~/Areas/Doctor/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Welcome -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            @SharedLocalizer["Welcome, Dr."] @Model.DoctorName
        </h2>

        <p class="text-muted mb-0">
            @Model.DepartmentName
        </p>
    </div>


    <!-- Main Statistics -->
    <div class="row g-4 mb-4">

        <!-- Today's Appointments -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                @SharedLocalizer["Today's Appointments"]
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TodayAppointments
                            </h2>
                        </div>

                        <div class="bg-primary bg-opacity-10 rounded-4 p-3">
                            <i class="fas fa-calendar-check text-primary fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- My Patients -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                @SharedLocalizer["My Patients"]
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.MyPatients
                            </h2>
                        </div>

                        <div class="bg-success bg-opacity-10 rounded-4 p-3">
                            <i class="fas fa-users text-success fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Pending Appointments -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                @SharedLocalizer["Pending Appointments"]
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.PendingAppointments
                            </h2>
                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-4 p-3">
                            <i class="fas fa-clock text-warning fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Average Rating -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                @SharedLocalizer["Average Rating"]
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.AverageRating.ToString("0.0")
                                <small class="text-warning">★</small>
                            </h2>
                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-4 p-3">
                            <i class="fas fa-star text-warning fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Appointment Status -->
    <div class="row g-4 mb-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-1">
                        @SharedLocalizer["Appointment Overview"]
                    </h5>

                    <p class="text-muted mb-0 small">
                        @SharedLocalizer["Overview of your appointment statuses"]
                    </p>
                </div>

                <div class="card-body px-4 pb-4">

                    <div class="row g-3">

                        <div class="col-md-3">
                            <div class="p-3 bg-warning bg-opacity-10 rounded-3">
                                <div class="text-muted small">
                                    @SharedLocalizer["Pending"]
                                </div>
                                <div class="fs-4 fw-bold">
                                    @Model.PendingAppointments
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="p-3 bg-primary bg-opacity-10 rounded-3">
                                <div class="text-muted small">
                                    @SharedLocalizer["Confirmed"]
                                </div>
                                <div class="fs-4 fw-bold">
                                    @Model.ConfirmedAppointments
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="p-3 bg-success bg-opacity-10 rounded-3">
                                <div class="text-muted small">
                                    @SharedLocalizer["Completed"]
                                </div>
                                <div class="fs-4 fw-bold">
                                    @Model.CompletedAppointments
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="p-3 bg-danger bg-opacity-10 rounded-3">
                                <div class="text-muted small">
                                    @SharedLocalizer["Cancelled"]
                                </div>
                                <div class="fs-4 fw-bold">
                                    @Model.CancelledAppointments
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Reviews -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-1">
                        @SharedLocalizer["Reviews"]
                    </h5>

                    <p class="text-muted mb-0 small">
                        @SharedLocalizer["Your patient feedback"]
                    </p>
                </div>

                <div class="card-body px-4">

                    <div class="text-center py-3">

                        <div class="display-5 fw-bold">
                            @Model.AverageRating.ToString("0.0")
                        </div>

                        <div class="text-warning fs-4">
                            ★★★★★
                        </div>

                        <div class="text-muted small mt-2">
                            @Model.TotalReviews @SharedLocalizer["Reviews"]
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Today's Appointments -->
    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-1">
                        @SharedLocalizer["Today's Appointments"]
                    </h5>

                    <p class="text-muted mb-0 small">
                        @SharedLocalizer["Your appointments scheduled for today"]
                    </p>

                </div>

                <div class="card-body p-0">

                    @if (Model.TodayAppointmentsList.Any())
                    {
                        <div class="table-responsive">

                            <table class="table align-middle mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th class="px-4">@SharedLocalizer["Time"]</th>
                                        <th>@SharedLocalizer["Patient"]</th>
                                        <th>@SharedLocalizer["STATUS"]</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var appointment in Model.TodayAppointmentsList)
                                    {
                                        <tr>

                                            <td class="px-4 fw-semibold">
                                                @appointment.AppointmentTime.ToString("hh\\:mm")
                                            </td>

                                            <td>
                                                @(appointment.Patient?.ApplicationUser?.FullName ?? SharedLocalizer["Unknown Patient"].Value)
                                            </td>

                                            <td>

                                                @if (appointment.Status == AppointmentStatus.Pending)
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill px-3">
                                                        @SharedLocalizer["Pending"]
                                                    </span>
                                                }
                                                else if (appointment.Status == AppointmentStatus.Confirmed)
                                                {
                                                    <span class="badge bg-primary rounded-pill px-3">
                                                        @SharedLocalizer["Confirmed"]
                                                    </span>
                                                }
                                                else if (appointment.Status == AppointmentStatus.Completed)
                                                {
                                                    <span class="badge bg-success rounded-pill px-3">
                                                        @SharedLocalizer["Completed"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger rounded-pill px-3">
                                                        @SharedLocalizer["Cancelled"]
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="fas fa-calendar-times text-muted fs-1 mb-3"></i>

                            <h6 class="fw-bold">
                                @SharedLocalizer["No appointments today"]
                            </h6>

                            <p class="text-muted small mb-0">
                                @SharedLocalizer["You don't have any appointments scheduled for today."]
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Quick Summary -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-1">
                        @SharedLocalizer["Quick Summary"]
                    </h5>

                    <p class="text-muted mb-0 small">
                        @SharedLocalizer["Your overall activity"]
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="d-flex justify-content-between py-3 border-bottom">
                        <span class="text-muted">
                            @SharedLocalizer["Total Appointments"]
                        </span>

                        <span class="fw-bold">
                            @Model.TotalAppointments
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-3 border-bottom">
                        <span class="text-muted">
                            @SharedLocalizer["Total Patients"]
                        </span>

                        <span class="fw-bold">
                            @Model.MyPatients
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-3 border-bottom">
                        <span class="text-muted">
                            @SharedLocalizer["Completed"]
                        </span>

                        <span class="fw-bold text-success">
                            @Model.CompletedAppointments
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-3">
                        <span class="text-muted">
                            @SharedLocalizer["Reviews"]
                        </span>

                        <span class="fw-bold">
                            @Model.TotalReviews
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>