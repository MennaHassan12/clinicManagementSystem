@model clinicManagementSystem.ViewModels.MedicalFileVM

@{
    ViewData["Title"] = "Create Medical File";
    Layout = "~/Areas/Doctor/Views/Shared/_Layout.cshtml";

    var medicalRecords =
        ViewBag.MedicalRecords as IEnumerable<dynamic>;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                Add Medical File
            </h2>

            <p class="text-muted mb-0">
                Upload a PDF or image to a medical record
            </p>
        </div>

        

    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fas fa-exclamation-circle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fas fa-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-body p-4">

            <form method="post"
                  action="@Url.Action("Create", "MedicalFiles", new { area = "Doctor" })"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- Medical Record -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Medical Record
                    </label>

                    <select id="MedicalRecordId"
                            name="MedicalRecordId"
                            class="form-select">

                        <option value="">
                            -- Select Medical Record --
                        </option>

                        @if (medicalRecords != null)
                        {
                            foreach (var record in medicalRecords)
                            {
                                <option value="@record.Id">
                                    @record.Display
                                </option>
                            }
                        }

                    </select>

                    <span class="text-danger">
                        @Html.ValidationMessage("MedicalRecordId")
                    </span>

                </div>


                <!-- Upload Date -->

                <div class="mb-4">

                    <label asp-for="UploadDate"
                           class="form-label fw-semibold">

                        Upload Date

                    </label>

                    <input asp-for="UploadDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="UploadDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Medical Files -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Medical Files
                    </label>

                    <input type="file"
                           id="uploadedFiles"
                           name="uploadedFiles"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png"
                           multiple
                           required />

                    <div class="form-text mt-2">

                        <i class="fas fa-info-circle me-1"></i>

                        You can select multiple files at once.
                        Allowed files: PDF, JPG, JPEG and PNG.
                        Maximum size: 10 MB per file.

                    </div>

                </div>


                <!-- Buttons -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary rounded-pill">

                        Upload File

                    </button>

                    <a href="@Url.Action("Index", "MedicalFiles", new { area = "Doctor" })"
                       class="btn btn-outline-secondary rounded-pill">

                        Cancel

                    </a>

                    

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}