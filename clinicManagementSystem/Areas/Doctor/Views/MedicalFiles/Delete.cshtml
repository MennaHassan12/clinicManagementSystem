@model clinicManagementSystem.Models.MedicalFile

@{
    ViewData["Title"] = SharedLocalizer["Delete Medical File"];
    Layout = "~/Areas/Doctor/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger mb-1">
                @SharedLocalizer["Delete Medical File"]
            </h2>

            <p class="text-muted mb-0">
                @SharedLocalizer["Confirm deletion of this medical file"]
            </p>
        </div>

        

    </div>

    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-body p-4">

            <div class="alert alert-warning">

                <i class="fas fa-exclamation-triangle me-2"></i>

                @SharedLocalizer["Are you sure you want to delete this medical file?"]

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="fw-semibold text-muted">
                        @SharedLocalizer["Medical File ID"]
                    </label>

                    <div class="form-control bg-light">
                        @Model.MedicalFileId
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-semibold text-muted">
                        @SharedLocalizer["Medical Record ID"]
                    </label>

                    <div class="form-control bg-light">
                        @Model.MedicalRecordId
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-semibold text-muted">
                        @SharedLocalizer["File Name"]
                    </label>

                    <div class="form-control bg-light">
                        @Model.FileName
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-semibold text-muted">
                        @SharedLocalizer["File Type"]
                    </label>

                    <div class="form-control bg-light">
                        @Model.FileType
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-semibold text-muted">
                        @SharedLocalizer["Upload Date"]
                    </label>

                    <div class="form-control bg-light">
                        @Model.UploadDate.ToString("dd/MM/yyyy")
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-semibold text-muted">
                        @SharedLocalizer["File Path"]
                    </label>

                    <div class="form-control bg-light">
                        @Model.FilePath
                    </div>

                </div>

            </div>

            <form asp-area="Doctor"
                  asp-controller="MedicalFiles"
                  asp-action="Delete"
                  asp-route-id="@Model.MedicalFileId"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <div class="d-flex  gap-2">
                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">

                        @SharedLocalizer["Delete Medical File"]

                    </button>

                    <a asp-area="Doctor"
                       asp-controller="MedicalFiles"
                       asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">

                        @SharedLocalizer["Cancel"]

                    </a>

                    

                </div>

            </form>

        </div>

    </div>

</div>