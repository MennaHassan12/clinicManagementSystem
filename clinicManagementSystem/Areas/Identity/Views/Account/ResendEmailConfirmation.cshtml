@model clinicManagementSystem.ViewModels.ResendEmailConfirmationVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = SharedLocalizer["Resend Confirmation"];
    Layout = "_MainLayout";
}
<h2>@SharedLocalizer["Resend Confirmation"]</h2>
<p class="subtitle">@SharedLocalizer["Enter your email and we'll resend the confirmation link"]</p>

<form asp-action="ResendEmailConfirmation" asp-controller="Account" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Email">@SharedLocalizer["Email"]</label>
        <div class="input-field">
            <span class="icon icon-email"></span>
            <input asp-for="Email" type="email" placeholder="@SharedLocalizer["Enter your email"]" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">@SharedLocalizer["RESEND CONFIRMATION EMAIL"]</button>

</form>

<div class="switch-link">
    @SharedLocalizer["Back to"] <a asp-action="Login" asp-controller="Account">@SharedLocalizer["Log In"]</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}