@model clinicManagementSystem.ViewModels.ResendEmailConfirmationVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Resend Confirmation";
    Layout = "_MainLayout";
}
             <h2>Resend Confirmation</h2>
            <p class="subtitle">Enter your email and we'll resend the confirmation link</p>

            @if (TempData["success_notification"] != null)
            {
                <div class="success-banner">@TempData["success_notification"]</div>
            }

            <form asp-action="ResendEmailConfirmation" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <div class="input-field">
                        <span class="icon icon-email"></span>
                        <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button type="submit" class="btn-primary">RESEND CONFIRMATION EMAIL</button>
              
            </form>

            <div class="switch-link">
                Back to <a asp-action="Login" asp-controller="Account">Sign In</a>
            </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}
