@model clinicManagementSystem.ViewModels.ForgetPasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = SharedLocalizer["Forgot password?"];
    Layout = "_MainLayout";
}

<h2>@SharedLocalizer["Forgot password?"]</h2>
<p class="subtitle">@SharedLocalizer["Enter your Email"]</p>

@if (TempData["success_notification"] != null)
{
    <div class="success-banner">@TempData["success_notification"]</div>
}

<form asp-action="ForgetPassword" asp-controller="Account" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Email">@SharedLocalizer["Email Address"]</label>
        <div class="input-field">
            <span class="icon icon-email"></span>
            <input asp-for="Email" type="email" placeholder="@SharedLocalizer["Enter your Email"]" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">@SharedLocalizer["Resend email confirmation"]</button>
</form>

<div class="switch-link">
    @SharedLocalizer["Already have an account?"] <a asp-action="Login" asp-controller="Account">@SharedLocalizer["Sign In"]</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}