@model clinicManagementSystem.ViewModels.ForgetPasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = SharedLocalizer["Forgot Password"];
    Layout = "_MainLayout";
}

<h2>@SharedLocalizer["Forgot Password"]</h2>
<p class="subtitle">@SharedLocalizer["Enter your email and we'll send you a verification code"]</p>

<form asp-action="ForgetPassword" asp-controller="Account" method="post" novalidate>
    @Html.AntiForgeryToken()

   
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    
    <div class="form-group">
        <label asp-for="Email">@SharedLocalizer["Email"]</label>
        <div class="input-field">
            <span class="icon icon-email"></span>
            <input asp-for="Email" type="email" placeholder="@SharedLocalizer["Enter your email"]" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">@SharedLocalizer["SEND CODE"]</button>
</form>

<div class="switch-link">
    @SharedLocalizer["Remembered your password?"] <a asp-action="Login" asp-controller="Account">@SharedLocalizer["Log In"]</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}