@model clinicManagementSystem.ViewModels.ValidateOTPVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = SharedLocalizer["Forgot password?"];
    Layout = "_MainLayout";
}

<h2>@SharedLocalizer["Forgot password?"]</h2>
<p class="subtitle">@SharedLocalizer["Enter your Email"]</p>

@if (TempData["success_notification"] != null)
{
    <div class="success-banner">@TempData["success_notification"]</div>
}

<form asp-action="ValidateOTP" asp-controller="Account" method="post" id="otpForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <input asp-for="Email" type="hidden" />

    <div class="form-group">
        <input asp-for="Otp" type="text" inputmode="numeric" maxlength="6"
               class="otp-single-box" autocomplete="one-time-code" autofocus
               oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        <span asp-validation-for="Otp" class="field-error" style="text-align:center;"></span>
    </div>

    <button type="submit" class="btn-primary">@SharedLocalizer["Confirm & Book"]</button>
</form>

<div class="resend-link">
    @SharedLocalizer["Didn't receive the confirmation email?"]
    <a asp-action="ForgetPassword" asp-controller="Account">@SharedLocalizer["Resend email confirmation"]</a>
</div>
<form asp-action="ResendOTP" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="email" value="@Model.Email" />
    <button type="submit" class="btn-secondary">@SharedLocalizer["Resend email confirmation"]</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}
