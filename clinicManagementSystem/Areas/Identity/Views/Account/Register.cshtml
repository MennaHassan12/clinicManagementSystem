@model clinicManagementSystem.ViewModels.RegisterVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Register";
    Layout = "_MainLayout";
}

<h2>Create Account</h2>
<p class="subtitle">Fill in your details to access the diagnostic platform</p>
@if (TempData["success_notification"] != null)
{
    <div class="success-banner">@TempData["success_notification"]</div>
}


<form asp-action="Register" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

   
    <div class="form-group">
        <label asp-for="FullName">Full Name</label>
        <div class="input-field">
            <span class="icon icon-user"></span>
            <input asp-for="FullName" placeholder="Enter your full name" autocomplete="name" />
        </div>
        <span asp-validation-for="FullName" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">Email</label>
        <div class="input-field">
            <span class="icon icon-email"></span>
            <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber">Phone Number</label>
        <div class="input-field">
            <span class="icon icon-phone"></span>
            <input asp-for="PhoneNumber" type="tel" placeholder="Enter your phone number" autocomplete="tel" />
        </div>
        <span asp-validation-for="PhoneNumber" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password">Password</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="new-password" id="passwordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('passwordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">Confirm Password</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="ConfirmPassword" type="password" placeholder="Re-enter your password" autocomplete="new-password" id="confirmPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('confirmPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">SIGN UP</button>

</form>

<div class="switch-link">
    Already have an account? <a asp-action="Login" asp-controller="Account">Sign In</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}

 
