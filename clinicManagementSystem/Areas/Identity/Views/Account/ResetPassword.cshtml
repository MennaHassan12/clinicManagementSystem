@model clinicManagementSystem.ViewModels.NewPasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = SharedLocalizer["Reset Password"];
    Layout = "_MainLayout";
}

<h2>@SharedLocalizer["Reset Password"]</h2>
<p class="subtitle">@SharedLocalizer["Create a new password for your account"]</p>

<form asp-action="ResetPassword" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

  

    <input asp-for="Email" type="hidden" />

    <div class="form-group">
        <label asp-for="Password">@SharedLocalizer["New Password"]</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="Password" type="password" placeholder="@SharedLocalizer["Enter your new password"]" autocomplete="new-password" id="newPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('newPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">@SharedLocalizer["Confirm Password"]</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="ConfirmPassword" type="password" placeholder="@SharedLocalizer["Re-enter your new password"]" autocomplete="new-password" id="confirmNewPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('confirmNewPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary text-uppercase">@SharedLocalizer["Reset Password"]</button>
</form>

<div class="switch-link">
    @SharedLocalizer["Back to"] <a asp-action="Login" asp-controller="Account">@SharedLocalizer["Log In"]</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}