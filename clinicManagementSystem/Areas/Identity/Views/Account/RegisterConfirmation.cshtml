@{
    ViewData["Title"] = SharedLocalizer["Registration Confirmation"];
    Layout = "_MainLayout";
}

<h2>@SharedLocalizer["Check Your Email"]</h2>
<p class="subtitle">@SharedLocalizer["We've sent a confirmation link to your email address"]</p>

<div class="success-banner">
    @SharedLocalizer["Please check your inbox and click the confirmation link to activate your account. If you didn't receive it, check your spam folder."]
</div>

<div class="switch-link">
    @SharedLocalizer["Already confirmed?"] <a asp-action="Login" asp-controller="Account">@SharedLocalizer["Log In"]</a>
</div>
