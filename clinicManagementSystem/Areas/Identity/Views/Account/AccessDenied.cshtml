@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_MainLayout";
}

<div class="d-flex justify-content-center mb-3">
    <div class="d-flex align-items-center justify-content-center rounded-circle text-white"
         style="width: 84px; height: 84px; background: linear-gradient(135deg, #ff6b6b, #c02929); box-shadow: 0 10px 25px rgba(220, 50, 50, 0.4);">
        <i class="bi bi-shield-lock-fill" style="font-size: 40px;"></i>
    </div>
</div>

<h2>Access Denied</h2>
<p class="subtitle">You don't have permission to view this page</p>

<p class="access-message">
    This area is restricted to authorized personnel only.
    If you believe this is a mistake, please contact the administrator.
</p>

<a asp-area="Patient" asp-controller="Home" asp-action="Index"
   class="btn-primary text-decoration-none d-block text-center">
    Back to Home
</a>

<div class="switch-link">
    Want to use another account?
    <a asp-action="Logout" asp-controller="Account">Logout</a>
</div>

<style>
    .access-message {
        color: #a9b6de;
        font-size: 12px;
        text-align: center;
        line-height: 1.7;
        margin-bottom: 20px;
    }
</style>
