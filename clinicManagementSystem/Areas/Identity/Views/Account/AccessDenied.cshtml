@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_MainLayout";
}

<div class="d-flex justify-content-center mb-3">
    <div class="d-flex align-items-center justify-content-center rounded-circle text-white"
         style="width: 84px; height: 84px; background: linear-gradient(135deg, #ff6b6b, #c02929); box-shadow: 0 10px 25px rgba(220, 50, 50, 0.4);">
        <i class="bi bi-shield-lock-fill" style="font-size: 40px;"></i>
    </div>
</div>

<h2>Access Denied</h2>
<p class="subtitle">You don't have permission to view this page</p>

<p class="access-message">
    This area is restricted to authorized personnel only.
    If you believe this is a mistake, please contact the administrator.
</p>

<button type="button" id="backToPreviousBtn"
        class="btn-primary text-decoration-none d-block w-100 text-center border-0">
    Back to Previous Page
</button>

<div class="switch-link">
    Want to use another account?
    <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="logout-link-button">Logout</button>
    </form>
</div>

<script>
    document.getElementById("backToPreviousBtn").addEventListener("click", function () {
        if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = '@Url.Action("Index", "Home", new { area = "Patient" })';
        }
    });
</script>

<style>
    .access-message {
        color: #a9b6de;
        font-size: 12px;
        text-align: center;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .logout-link-button {
        background: none;
        border: none;
        padding: 0;
        color: #6f9bff;
        font-weight: 700;
        font-size: 12px;
        text-decoration: none;
        cursor: pointer;
    }

    .logout-link-button:hover {
        text-decoration: underline;
    }
</style>
