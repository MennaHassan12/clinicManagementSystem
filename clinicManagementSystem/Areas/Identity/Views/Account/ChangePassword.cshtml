@model clinicManagementSystem.ViewModels.ChangePasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = SharedLocalizer["Forgot password?"];
    Layout = "_MainLayout";
}

<h2>@SharedLocalizer["Forgot password?"]</h2>
<p class="subtitle">@SharedLocalizer["Enter your password"]</p>
@if (TempData["success_notification"] != null)
{
    <div class="success-banner">@TempData["success_notification"]</div>
}


<form asp-action="ChangePassword" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <div class="password-label-row">
            <label asp-for="CurrentPassword">@SharedLocalizer["Password"]</label>
            <a asp-action="ForgetPassword" asp-controller="Account" class="forgot-link">@SharedLocalizer["Forgot password?"]</a>
        </div>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="CurrentPassword" type="password" placeholder="@SharedLocalizer["Enter your password"]" autocomplete="current-password" id="currentPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('currentPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="NewPassword">@SharedLocalizer["Password"]</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="NewPassword" type="password" placeholder="@SharedLocalizer["Enter your password"]" autocomplete="new-password" id="newPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('newPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">@SharedLocalizer["Confirm Password"]</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="ConfirmPassword" type="password" placeholder="@SharedLocalizer["Re-enter your password"]" autocomplete="new-password" id="confirmPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('confirmPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">@SharedLocalizer["Confirm & Book"]</button>
</form>

<div class="switch-link">
    @SharedLocalizer["Back"] <a asp-action="Index" asp-controller="Profile">@SharedLocalizer["My Profile"]</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}