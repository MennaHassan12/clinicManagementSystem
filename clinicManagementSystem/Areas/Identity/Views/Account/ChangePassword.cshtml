@model clinicManagementSystem.ViewModels.ChangePasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Change Password";
    Layout = "_MainLayout";
}

<h2>Change Password</h2>
<p class="subtitle">Update your password to keep your account secure</p>
<p class="subtitle">                
    Changing password for:
    <b>@(User?.Identity?.IsAuthenticated == true ? User.Identity?.Name ?? "Unknown" : "Guest")</b>
</p>
@if (TempData["success_notification"] != null)
{
    <div class="success-banner">@TempData["success_notification"]</div>
}


<form asp-action="ChangePassword" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <div class="password-label-row">
            <label asp-for="CurrentPassword">Current Password</label>
            <a asp-action="ForgetPassword" asp-controller="Account" class="forgot-link">Forgot password?</a>
        </div>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="CurrentPassword" type="password" placeholder="Enter your current password" autocomplete="current-password" id="currentPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('currentPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="NewPassword">New Password</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="NewPassword" type="password" placeholder="Enter your new password" autocomplete="new-password" id="newPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('newPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">Confirm Password</label>
        <div class="input-field">
            <span class="icon icon-lock"></span>
            <input asp-for="ConfirmPassword" type="password" placeholder="Re-enter your new password" autocomplete="new-password" id="confirmPasswordInput" />
            <button type="button" class="toggle-password" onclick="togglePwd('confirmPasswordInput', this)">
                <span class="icon icon-eye"></span>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">CHANGE PASSWORD</button>
</form>

<div class="switch-link">
    Back to <a asp-action="Index" asp-controller="Profile">My Profile</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}