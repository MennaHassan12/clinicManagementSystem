@{
    Layout = "~/Areas/Identity/Views/Shared/_AuthLayout.cshtml";
}

<div class="register-wrapper">

    <div class="brand">
        <div class="brand-icon">
            <span class="icon icon-clinic"></span>
        </div>
        <div class="brand-text">
            <h1>@SharedLocalizer["Clinova"]</h1>
            <span>@SharedLocalizer["Smart Healthcare"]</span>
        </div>
    </div>

    <div class="register-card">
        @RenderBody()
    </div>

    <div class="footer-note">
        &copy; @DateTime.Now.Year <b>@SharedLocalizer["Clinova"]</b>.
    </div>

</div>

@if (IsSectionDefined("Scripts"))
{
    @section Scripts {
        @await RenderSectionAsync("Scripts", required: false)
    }
}
