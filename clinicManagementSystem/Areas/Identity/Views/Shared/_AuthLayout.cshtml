@using Microsoft.AspNetCore.Identity
@using clinicManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthCare Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <style>
        /* override register.css page-level rules so the auth form
           sits correctly inside the HealthCare navbar + small footer */
        html, body {
            height: auto;
            overflow: auto;
        }

        body {
            height: auto;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: flex-start;
            padding: 0;
            background: #f8f9fa;
        }

        /* gradient + centering applied to the free content area only */
        .auth-area {
            flex: 1 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(24px, 4vh, 48px) 16px;
            background: radial-gradient(circle at 30% 20%, #2c50b8 0%, #1c3a8f 40%, #0e1f52 75%, #081230 100%);
        }

        .register-wrapper {
            width: 100%;
            max-width: 400px;
            max-height: none;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .register-card {
            width: 100%;
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Top Bar -->
    <div class="bg-light border-bottom py-2 text-muted fs-7 d-none d-lg-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <span><i class="bi bi-geo-alt-fill text-primary me-1"></i> 123 Health Street, Cairo, Egypt</span>
                <span><i class="bi bi-envelope-fill text-primary me-1"></i> support@healthcareportal.com</span>
            </div>
            <div>
                <a class="text-decoration-none text-secondary fw-semibold" href="?culture=ar">
                    <i class="bi bi-globe me-1"></i> عربي
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-3 text-primary" href="/Patient/Home/Index">
                <i class="bi bi-heart-pulse-fill fs-2"></i>
                <span class="tracking-wide">HealthCare</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-semibold text-uppercase fs-7 gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link text-dark active" href="/Patient/Home/Index">Home</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark" href="#" id="pagesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Pages
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg rounded-3 py-2" aria-labelledby="pagesDropdown">
                            <li><a class="dropdown-item py-2" href="/Patient/Home/AllDoctors"><i class="bi bi-person-badge me-2 text-primary"></i>Doctors</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#departments"><i class="bi bi-hospital me-2 text-primary"></i>Departments</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Services"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Services</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#about"><i class="bi bi-info-circle me-2 text-primary"></i>About Us</a></li>
                            <li><a class="dropdown-item py-2" href="/Patient/Home/Index#contact"><i class="bi bi-envelope me-2 text-primary"></i>Contact Us</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Home/Index#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Home/Services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Patient/Home/Index#contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-primary rounded-pill px-4 dropdown-toggle fw-semibold" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" aria-labelledby="userMenu" style="min-width: 200px;">
                                <li>
                                    <a class="dropdown-item py-2 rounded-3 text-secondary" href="/Identity/Profile/Index">
                                        <i class="bi bi-gear me-2"></i>Profile Settings
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    @* On the auth pages (login/register) a logged-out visitor just sees the brand, no duplicate buttons *@
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="auth-area">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script src="~/js/register.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
